<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sofia Mendoza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body, html {
                height: 100%;
                margin: 0;
                background-color: #f8f9fa;
            }

            .login-wrapper {
                display: flex;
                min-height: 100vh;
                width: 100%;
            }

            .left-panel {
                flex: 1;
                background: linear-gradient(135deg, #111111 0%, #2a2a2a 100%);
                color: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 3rem;
                text-align: center;
            }

            .right-panel {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
                background-color: #ffffff;
            }

            @@media (max-width: 768px) {
                .login-wrapper {
                    flex-direction: column;
                }

                .left-panel {
                    padding: 2rem 1rem;
                }
            }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="left-panel">
            <div style="max-width: 450px;">
                <h1 style="font-family: serif; font-size: 2.8rem; letter-spacing: 2px; margin-bottom: 1rem;">
                    Bazzar Juanita Garcia xxx
                </h1>
                <p style="text-transform: uppercase; letter-spacing: 3px; font-size: 0.85rem; color: #cccccc; margin-bottom: 2rem;">
                    Boutique & Accessories
                </p>
                <hr style="border-color: rgba(255,255,255,0.2); margin: 2rem 0;" />
                <p style="font-size: 1.05rem; line-height: 1.6; color: #e0e0e0;">
                    Bienvenido a nuestra plataforma exclusiva. Gestiona tus pedidos, catálogo y colecciones desde un solo lugar.
                </p>
            </div>
        </div>

        <div class="right-panel">
            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>