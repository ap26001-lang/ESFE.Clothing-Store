@* 

*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MAISON ÉLITE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --bg-dark: #130a06;
                --bg-light: #f9f6f0;
                --color-gold: #c59b27;
                --color-muted: #8c7b73;
            }

            body {
                background-color: var(--bg-light);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                color: var(--bg-dark);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* BANNER Y NAVBAR SUPERIOR */
            .navbar-maison {
                background-color: var(--bg-dark);
                padding: 1rem 3rem;
                border-bottom: 1px solid rgba(197, 155, 39, 0.2);
            }

            .navbar-brand-custom {
                color: var(--color-gold) !important;
                font-family: serif;
                letter-spacing: 3px;
                font-size: 1.2rem;
                font-weight: 700;
                text-transform: uppercase;
            }

            .nav-link-custom {
                color: #ffffff !important;
                letter-spacing: 1px;
                font-size: 0.85rem;
                text-transform: uppercase;
                margin: 0 0.8rem;
                transition: color 0.2s;
            }

                .nav-link-custom:hover {
                    color: var(--color-gold) !important;
                }

            .user-pill {
                background-color: rgba(197, 155, 39, 0.15);
                border: 1px solid var(--color-gold);
                color: var(--color-gold);
                padding: 0.4rem 1rem;
                border-radius: 20px;
                font-size: 0.85rem;
            }

            main {
                flex: 1;
            }
    </style>
</head>
<body>

    <!-- NAVBAR PRINCIPAL -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-maison">
        <div class="container-fluid px-4">
            <a class="navbar-brand navbar-brand-custom" asp-controller="Home" asp-action="Index">MAISON ÉLITE</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">Catálogo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#">Novedades</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#">Colecciones</a>
                    </li>
                    <li class="nav-item">
    <a class="nav-link nav-link-custom" asp-controller="Vendedor" asp-action="Index">Vendedor</a>
</li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @* Comprobación simulada de usuario autenticado *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="user-pill">
                            <i class="bi bi-person-fill"></i> @User.Identity.Name (Cliente VIP)
                        </span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm text-uppercase">Cerrar Sesión</a>
                    }
                    else
                    {
                        <!-- Si entra como correo común o invitado -->
                        <span class="user-pill">
                            Sofía Mendoza (Cliente VIP)
                        </span>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-warning btn-sm text-uppercase" style="border-color: var(--color-gold); color: var(--color-gold);">Iniciar Sesión</a>
                    }
                </div>
            </div>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Panel Vendedor</a>
            </li>
        </div>
    </nav>

    <!-- CONTENIDO DEL CATÁLOGO / DASHBOARD (100% ANCHO) -->
    <main class="container-fluid py-4 px-4">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>