@{
    ViewData["Title"] = "Maison Élite - Autenticación";
}

<div class="container-fluid vh-100 p-0">
    <div class="row g-0 h-100">
        <!-- PANEL LATERAL IZQUIERDO (Branding Maison Élite) -->
        <div class="col-lg-6 sidebar-dark p-5 d-flex flex-column justify-content-between text-white" style="background-color: #1a1a1a;">
            <div>
                <span class="brand-subtitle text-uppercase tracking-widest small opacity-75">MAISON ÉLITE</span>
            </div>

            <div class="my-auto py-5">
                <h1 class="display-4 fw-bold mb-3">Gestión Exclusiva de Boutique</h1>
                <p class="lead opacity-75">Acceda al sistema de administración, catálogo de prendas y control operacional de la tienda.</p>
            </div>

            <div class="small opacity-50">
                &copy; @DateTime.Now.Year Maison Élite - Todos los derechos reservados.
            </div>
        </div>

        <!-- PANEL DERECHO (Módulo de Acceso / Dashboard Admin) -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center p-5 bg-light">
            <div class="w-100" style="max-width: 450px;">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Iniciar Sesión</h2>
                    <p class="text-muted">Ingrese sus credenciales para acceder</p>
                </div>

                <!-- AHORA APUNTA A HOME/LOGIN (Soluciona el Error 405) -->
                <form method="post" asp-controller="Home" asp-action="Login">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input type="email" class="form-control form-control-lg" id="email" name="Email" placeholder="admin@maisonelite.com" required />
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Contraseña</label>
                        <input type="password" class="form-control form-control-lg" id="password" name="Password" placeholder="••••••••" required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-dark btn-lg fw-semibold">Ingresar al Sistema</button>
                    </div>
                </form>

                <div class="border-top pt-4 mt-4 text-center">
                    <span class="badge bg-dark px-3 py-2">Rol Actual: Administrador</span>
                </div>
            </div>
        </div>
    </div>
</div>