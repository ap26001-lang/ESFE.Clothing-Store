        </div>
    </div>
</div>

<!-- SCRIPT GENERAL Y LÓGICA DE ROLES Y PANTALLAS -->
<script>
    let cart = [];

    // Cambiar entre Formulario de Login y Registro
    function toggleAuthView(event, targetView) {
        if (event) event.preventDefault();
        if (targetView === 'register') {
            document.getElementById('view-login').classList.add('d-none');
            document.getElementById('view-register').classList.remove('d-none');
        } else {
            document.getElementById('view-register').classList.add('d-none');
            document.getElementById('view-login').classList.remove('d-none');
        }
    }

    // Manejar el envío del Login
    function handleLoginSubmit(event) {
        event.preventDefault();
        const email = document.getElementById('loginEmail').value.trim().toLowerCase();

        if (!email) return;

        // Ocultar Contenedor de Autenticación Principal
        document.getElementById('view-auth-container').classList.add('d-none');

        if (email.includes('vendedor')) {
            // Mostrar Vista de Vendedor
            document.getElementById('view-dashboard-vendedor').classList.remove('d-none');
        } else {
            // Mostrar Vista de Cliente (por defecto para clientes y otros emails)
            const viewCliente = document.getElementById('view-cliente');
            viewCliente.classList.remove('d-none');
            viewCliente.classList.add('d-flex');
        }
    }

    // Manejar el envío del Registro
    function handleRegisterSubmit(event) {
        event.preventDefault();
        document.getElementById('view-auth-container').classList.add('d-none');
        const viewCliente = document.getElementById('view-cliente');
        viewCliente.classList.remove('d-none');
        viewCliente.classList.add('d-flex');
    }

    function handleGoogleAuth() {
        document.getElementById('view-auth-container').classList.add('d-none');
        const viewCliente = document.getElementById('view-cliente');
        viewCliente.classList.remove('d-none');
        viewCliente.classList.add('d-flex');
    }

    // Navegación del Panel de Cliente (Sidebar)
    function showClientSection(sectionId, event) {
        if (event) event.preventDefault();

        document.querySelectorAll('.client-section').forEach(sec => sec.style.display = 'none');
        const targetSection = document.getElementById('client-sec-' + sectionId);
        if (targetSection) targetSection.style.display = 'block';

        const links = document.querySelectorAll('#view-cliente .nav-link');
        links.forEach(link => {
            link.classList.remove('active', 'text-white');
            link.classList.add('text-white-50');
        });

        if (event && event.currentTarget) {
            event.currentTarget.classList.add('active', 'text-white');
            event.currentTarget.classList.remove('text-white-50');
        }
    }

    // Funciones del Vendedor
    function switchTabVendedor(tab) {
        document.getElementById('tab-pos').classList.add('d-none');
        document.getElementById('tab-catalogo-vendedor').classList.add('d-none');
        document.getElementById('tab-' + tab).classList.remove('d-none');

        const offcanvasEl = document.getElementById('sidebarMenuVendedor');
        const modal = bootstrap.Offcanvas.getInstance(offcanvasEl);
        if (modal) modal.hide();
    }

    function addToCart(name, price) {
        const item = cart.find(i => i.name === name);
        if (item) item.qty++;
        else cart.push({ name, price, qty: 1 });
        renderCart();
    }

    function updateQty(index, change) {
        cart[index].qty += change;
        if (cart[index].qty <= 0) cart.splice(index, 1);
        renderCart();
    }

    function renderCart() {
        const container = document.getElementById('cart-items');
        if (cart.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-3">Agrega prendas al carrito</p>';
            document.getElementById('cart-total').innerText = '$0';
            return;
        }

        let html = '';
        let total = 0;
        cart.forEach((item, index) => {
            total += item.price * item.qty;
            html += `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="fw-bold">${item.name}</div>
                            <small class="text-muted">$${item.price} c/u</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(${index}, -1)">-</button>
                            <span>${item.qty}</span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(${index}, 1)">+</button>
                            <span class="fw-bold ms-2">$${item.price * item.qty}</span>
                        </div>
                    </div>`;
        });
        container.innerHTML = html;
        document.getElementById('cart-total').innerText = '$' + total.toLocaleString();
    }

    // Cerrar sesión
    function logout() {
        location.reload();
    }
</script>