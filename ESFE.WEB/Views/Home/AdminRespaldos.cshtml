@model List<System.IO.FileInfo>
@{
    ViewData["Title"] = "Respaldos - Maison Élite";
    Layout = null;
    var nombreRespaldoSeleccionado = ViewBag.NombreRespaldoSeleccionado as string ?? string.Empty;
    var contenidoRespaldo = ViewBag.ContenidoRespaldo as string ?? string.Empty;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Respaldos de Seguridad - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
                --success-color: #2b7a5a;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .btn-create-backup {
                background-color: var(--sidebar-bg);
                color: var(--gold-light);
                border: 1px solid var(--gold-accent);
                padding: 10px 18px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
            }

                .btn-create-backup:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

                .custom-table th {
                    padding: 14px 16px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }

            .file-name {
                font-weight: 700;
                color: var(--text-dark);
            }

            .status-completed {
                color: var(--success-color);
                font-weight: 600;
            }

            .actions-cell {
                display: flex;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
            }

            .btn-action {
                background: none;
                border: none;
                color: var(--gold-accent);
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: color 0.2s;
                text-decoration: none;
                padding: 0;
            }

                .btn-action:hover {
                    color: var(--sidebar-bg);
                    text-decoration: underline;
                }

            .btn-delete {
                color: var(--text-muted);
            }

                .btn-delete:hover {
                    color: #a33c3c;
                }

            .inline-form {
                display: inline;
            }

            .backup-detail {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .backup-detail pre {
                margin-top: 16px;
                background-color: #f8f6f2;
                border: 1px solid #eee7dc;
                border-radius: 10px;
                padding: 18px;
                overflow: auto;
                white-space: pre-wrap;
                word-break: break-word;
                font-size: 0.82rem;
                line-height: 1.55;
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminCatalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminClientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminPuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminHistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminBitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item active"><a href="@Url.Action("AdminRespaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Respaldos de Base de Datos</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Genera y restaura copias de seguridad del sistema.</p>
            </div>
            <form method="post" action="@Url.Action("CrearRespaldo", "Home")">
                <button type="submit" class="btn-create-backup"><i class="fa-solid fa-database"></i> Crear Nuevo Respaldo</button>
            </form>
        </header>

        @if (TempData["MensajeRespaldo"] != null)
        {
            <div style="background-color: rgba(64, 130, 109, 0.12); color: #2e6050; border: 1px solid rgba(64, 130, 109, 0.2); padding: 12px 16px; border-radius: 10px; font-size: 0.9rem;">
                @TempData["MensajeRespaldo"]
            </div>
        }

        <section class="content-card">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Archivo</th>
                        <th>Fecha de Creación</th>
                        <th>Tamaño</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var respaldo in Model)
                        {
                            var tamanoMb = (respaldo.Length / 1024d / 1024d).ToString("0.##");
                            <tr>
                                <td class="file-name">@respaldo.Name</td>
                                <td>@respaldo.LastWriteTime.ToString("dd MMM yyyy - hh:mm tt")</td>
                                <td>@tamanoMb MB</td>
                                <td><span class="status-completed">Completado</span></td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="@Url.Action("AdminRespaldos", "Home", new { nombreArchivo = respaldo.Name })" class="btn-action"><i class="fa-solid fa-eye"></i> Ver</a>
                                        <a href="@Url.Action("DescargarRespaldo", "Home", new { nombreArchivo = respaldo.Name })" class="btn-action"><i class="fa-solid fa-download"></i> Descargar</a>
                                        <form method="post" action="@Url.Action("EliminarRespaldo", "Home")" class="inline-form" onsubmit="return confirm('¿Eliminar este respaldo?');">
                                            <input type="hidden" name="nombreArchivo" value="@respaldo.Name" />
                                            <button type="submit" class="btn-action btn-delete"><i class="fa-solid fa-trash"></i> Eliminar</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; color: var(--text-muted);">No hay archivos .bak en la carpeta de respaldos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (!string.IsNullOrWhiteSpace(nombreRespaldoSeleccionado) && !string.IsNullOrWhiteSpace(contenidoRespaldo))
        {
            <section class="backup-detail">
                <h2 style="font-family: 'Playfair Display', serif; font-size: 1.35rem; color: var(--text-dark);">Contenido del respaldo</h2>
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 6px;">Archivo: <strong>@nombreRespaldoSeleccionado</strong></p>
                <pre>@contenidoRespaldo</pre>
            </section>
        }
    </main>

</body>
</html>
