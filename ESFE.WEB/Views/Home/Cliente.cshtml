    <script>

            /*
             * CATÁLOGO DE PRESENTACIÓN DEL CLIENTE
             * ------------------------------------
             * NO usa la base de datos.
             * Los nombres, precios e imágenes se guardan en localStorage.
             */

            const CLAVE_CATALOGO = "maison_elite_catalogo_cliente";

            const productosIniciales = [
                { id: "producto-1", nombre: "Blazer Cachemira Oscuro", precio: 2500, imagen: "" },
                { id: "producto-2", nombre: "Vestido Seda Ivory", precio: 1800, imagen: "" },
                { id: "producto-3", nombre: "Abrigo Lana Merino", precio: 3200, imagen: "" },
                { id: "producto-4", nombre: "Pantalón Tweed Beige", precio: 890, imagen: "" },
                { id: "producto-5", nombre: "Blusa Lino Crema", precio: 620, imagen: "" },
                { id: "producto-6", nombre: "Falda Plisado Champagne", precio: 740, imagen: "" }
            ];

            let productosCatalogo = [];
            let productoEditandoId = null;


            function cargarCatalogo() {

                const guardado = localStorage.getItem(CLAVE_CATALOGO);

                if (guardado) {

                    try {
                        productosCatalogo = JSON.parse(guardado);
                    }
                    catch (error) {
                        productosCatalogo = productosIniciales.map(p => ({ ...p }));
                        guardarCatalogo();
                    }

                }
                else {

                    productosCatalogo = productosIniciales.map(p => ({ ...p }));
                    guardarCatalogo();

                }

                renderizarCatalogo();
            }


            function guardarCatalogo() {
                localStorage.setItem(
                    CLAVE_CATALOGO,
                    JSON.stringify(productosCatalogo)
                );
            }


            function escaparHtml(texto) {

                const div = document.createElement("div");
                div.textContent = texto ?? "";

                return div.innerHTML;
            }


            function renderizarCatalogo() {

                const contenedor =
                    document.getElementById("catalogoProductos");

                if (!contenedor) {
                    return;
                }

                if (!productosCatalogo.length) {

                    contenedor.innerHTML = `
                        <div class="catalogo-vacio">
                            No hay productos en el catálogo.
                        </div>
                    `;

                    return;
                }

                contenedor.innerHTML =
                    productosCatalogo.map(function (producto) {

                        const nombre =
                            escaparHtml(producto.nombre);

                        const precio =
                            Number(producto.precio || 0).toLocaleString(
                                "en-US",
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            );

                        const imagen =
                            producto.imagen
                                ? `<img src="${producto.imagen}" alt="${nombre}" class="catalog-product-image">`
                                : `<div class="catalog-product-placeholder">Imagen</div>`;

                        return `
                            <div class="card">

                                <div class="card-image catalog-card-image">
                                    ${imagen}
                                </div>

                                <div class="card-body">

                                    <div class="card-name">
                                        ${nombre}
                                    </div>

                                    <div class="card-price">
                                        $${precio}
                                    </div>

                                    <div class="catalog-card-actions">

                                        <button
                                            class="card-button"
                                            type="button"
                                            onclick="verProducto('${producto.id}')">
                                            Ver producto
                                        </button>

                                        <button
                                            class="card-button"
                                            type="button"
                                            onclick="abrirCompra('${producto.id}')">
                                            Comprar
                                        </button>

                                        <button
                                            class="catalog-edit-small"
                                            type="button"
                                            onclick="abrirEditor('${producto.id}')"
                                            title="Editar producto">
                                            ✎
                                        </button>

                                    </div>

                                </div>

                            </div>
                        `;

                    }).join("");
            }


            function abrirEditor(id) {

                const producto =
                    productosCatalogo.find(p => p.id === id);

                if (!producto) {
                    return;
                }

                productoEditandoId = id;

                document.getElementById("editorTitulo").textContent =
                    "Editar producto";

                document.getElementById("editorNombre").value =
                    producto.nombre;

                document.getElementById("editorPrecio").value =
                    producto.precio;

                document.getElementById("editorImagen").value = "";

                actualizarVistaPrevia(producto.imagen);

                document.getElementById("btnEliminarProducto").style.display =
                    "block";

                document.getElementById("editorProducto").style.display =
                    "flex";
            }


            function abrirEditorNuevo() {

                productoEditandoId = null;

                document.getElementById("editorTitulo").textContent =
                    "Agregar producto";

                document.getElementById("editorNombre").value = "";

                document.getElementById("editorPrecio").value = "";

                document.getElementById("editorImagen").value = "";

                actualizarVistaPrevia("");

                document.getElementById("btnEliminarProducto").style.display =
                    "none";

                document.getElementById("editorProducto").style.display =
                    "flex";
            }


            function cerrarEditor() {

                document.getElementById("editorProducto").style.display =
                    "none";

                productoEditandoId = null;
            }


            function actualizarVistaPrevia(imagen) {

                const preview =
                    document.getElementById("editorPreview");

                if (imagen) {

                    preview.innerHTML =
                        `<img src="${imagen}" alt="Vista previa">`;

                }
                else {

                    preview.innerHTML =
                        `<span>Sin imagen</span>`;

                }
            }


            function procesarImagen(archivo) {

                return new Promise(function (resolve, reject) {

                    if (!archivo) {
                        resolve("");
                        return;
                    }

                    const lector = new FileReader();

                    lector.onload = function (evento) {

                        const imagen = new Image();

                        imagen.onload = function () {

                            const maximo = 1000;

                            let ancho = imagen.width;
                            let alto = imagen.height;

                            if (ancho > maximo || alto > maximo) {

                                if (ancho > alto) {
                                    alto = Math.round(alto * maximo / ancho);
                                    ancho = maximo;
                                }
                                else {
                                    ancho = Math.round(ancho * maximo / alto);
                                    alto = maximo;
                                }
                            }

                            const canvas =
                                document.createElement("canvas");

                            canvas.width = ancho;
                            canvas.height = alto;

                            const contexto =
                                canvas.getContext("2d");

                            contexto.drawImage(
                                imagen,
                                0,
                                0,
                                ancho,
                                alto
                            );

                            resolve(
                                canvas.toDataURL(
                                    "image/jpeg",
                                    0.82
                                )
                            );
                        };

                        imagen.onerror = reject;
                        imagen.src = evento.target.result;
                    };

                    lector.onerror = reject;
                    lector.readAsDataURL(archivo);

                });
            }


            async function guardarProductoLocal() {

                const nombre =
                    document.getElementById("editorNombre")
                        .value
                        .trim();

                const precioTexto =
                    document.getElementById("editorPrecio")
                        .value
                        .trim();

                const archivo =
                    document.getElementById("editorImagen")
                        .files[0];

                if (!nombre) {
                    alert("Escribe el nombre del producto.");
                    return;
                }

                if (!precioTexto || Number(precioTexto) < 0) {
                    alert("Escribe un precio válido.");
                    return;
                }

                const precio = Number(precioTexto);

                try {

                    let imagen = "";

                    if (archivo) {
                        imagen = await procesarImagen(archivo);
                    }

                    if (productoEditandoId) {

                        const producto =
                            productosCatalogo.find(
                                p => p.id === productoEditandoId
                            );

                        if (!producto) {
                            return;
                        }

                        producto.nombre = nombre;
                        producto.precio = precio;

                        if (imagen) {
                            producto.imagen = imagen;
                        }

                    }
                    else {

                        productosCatalogo.push({

                            id: "producto-" + Date.now(),
                            nombre: nombre,
                            precio: precio,
                            imagen: imagen

                        });

                    }

                    guardarCatalogo();
                    renderizarCatalogo();
                    cerrarEditor();

                }
                catch (error) {

                    console.error(error);

                    alert(
                        "No se pudo guardar la imagen. " +
                        "Prueba con una imagen más pequeña."
                    );
                }
            }


            function eliminarProductoLocal() {

                if (!productoEditandoId) {
                    return;
                }

                const producto =
                    productosCatalogo.find(
                        p => p.id === productoEditandoId
                    );

                if (!producto) {
                    return;
                }

                const confirmar =
                    confirm(
                        `¿Quieres eliminar "${producto.nombre}" del catálogo?`
                    );

                if (!confirmar) {
                    return;
                }

                productosCatalogo =
                    productosCatalogo.filter(
                        p => p.id !== productoEditandoId
                    );

                guardarCatalogo();
                renderizarCatalogo();
                cerrarEditor();
            }


            function verProducto(id) {

                const producto =
                    productosCatalogo.find(p => p.id === id);

                if (!producto) {
                    return;
                }

                const precio = Number(producto.precio || 0).toLocaleString(
                    "en-US",
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 }
                );

                const imagen = producto.imagen
                    ? `<img src="${producto.imagen}" alt="${escaparHtml(producto.nombre)}" class="product-view-image">`
                    : `<div class="editor-preview"><span>Este producto todavía no tiene imagen.</span></div>`;

                document.getElementById("productoModalTitulo").textContent = producto.nombre;
                document.getElementById("productoModalContenido").innerHTML = `
                    ${imagen}
                    <div class="purchase-summary">
                        <span>Precio</span>
                        <strong class="purchase-total">$${precio}</strong>
                    </div>
                    <div class="editor-buttons">
                        <button type="button" class="editor-button" onclick="cerrarProductoModal()">Cerrar</button>
                        <button type="button" class="editor-button editor-button-save" onclick="cerrarProductoModal(); abrirCompra('${producto.id}')">Comprar</button>
                    </div>
                `;

                document.getElementById("productoModal").style.display = "flex";
            }


            function cerrarProductoModal() {
                document.getElementById("productoModal").style.display = "none";
            }


            function abrirCompra(id) {

                const producto =
                    productosCatalogo.find(p => p.id === id);

                if (!producto) {
                    return;
                }

                const precio = Number(producto.precio || 0).toLocaleString(
                    "en-US",
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 }
                );

                document.getElementById("compraContenido").innerHTML = `
                    <div class="purchase-summary">
                        <div>
                            <strong>${escaparHtml(producto.nombre)}</strong><br>
                            <span>1 unidad</span>
                        </div>
                        <strong class="purchase-total">$${precio}</strong>
                    </div>

                    <p class="demo-payment-note">
                        Pago de demostración para la presentación. No realiza cargos reales ni conecta con un banco.
                    </p>

                    <div class="demo-card">
                        <div class="demo-card-title">Maison Élite · Tarjeta de demostración</div>
                        <div class="demo-card-number">••••  ••••  ••••  4242</div>
                        <div>Pago seguro de demostración</div>
                    </div>

                    <div class="editor-buttons">
                        <button type="button" class="editor-button" onclick="cerrarCompra()">Cancelar</button>
                        <button type="button" class="editor-button editor-button-save" onclick="confirmarCompra('${producto.id}')">Pagar $${precio}</button>
                    </div>
                `;

                document.getElementById("compraModal").style.display = "flex";
            }


            function cerrarCompra() {
                document.getElementById("compraModal").style.display = "none";
            }


            function confirmarCompra(id) {

                const producto =
                    productosCatalogo.find(p => p.id === id);

                if (!producto) {
                    return;
                }

                const clave = "maison_elite_pedidos_demo";
                let pedidos = [];

                try {
                    pedidos = JSON.parse(localStorage.getItem(clave) || "[]");
                } catch (error) {
                    pedidos = [];
                }

                pedidos.push({
                    id: "pedido-" + Date.now(),
                    producto: producto.nombre,
                    precio: Number(producto.precio || 0),
                    fecha: new Date().toLocaleDateString("es-SV"),
                    metodo: "Tarjeta de demostración"
                });

                localStorage.setItem(clave, JSON.stringify(pedidos));

                document.getElementById("compraContenido").innerHTML = `
                    <div class="demo-success">
                        <div class="demo-success-icon">✓</div>
                        <h2 style="font-family:'Playfair Display',serif;font-weight:400;">¡Compra realizada!</h2>
                        <p>Pedido de demostración registrado correctamente.</p>
                        <p><strong>${escaparHtml(producto.nombre)}</strong></p>
                        <button type="button" class="editor-button editor-button-save" onclick="cerrarCompra(); mostrarSeccion('inicio')">Continuar</button>
                    </div>
                `;
            }


            /* ==========================
               FOTOS DEL INICIO Y PERFIL
               ========================== */

            const CLAVE_INICIO_FOTOS = "maison_elite_fotos_inicio";
            const CLAVE_FOTO_PERFIL = "maison_elite_foto_perfil";

            const fotosInicioIniciales = {
                "inicio-1": "",
                "inicio-2": "",
                "inicio-3": "",
                "inicio-4": ""
            };

            function cargarFotosInicio() {

                let guardadas = {};

                try {
                    guardadas =
                        JSON.parse(
                            localStorage.getItem(CLAVE_INICIO_FOTOS) || "{}"
                        );
                }
                catch (error) {
                    guardadas = {};
                }

                Object.keys(fotosInicioIniciales).forEach(function (id) {

                    fotosInicioIniciales[id] =
                        guardadas[id] || "";

                    const contenedor =
                        document.getElementById("homeImage-" + id);

                    if (!contenedor) {
                        return;
                    }

                    if (fotosInicioIniciales[id]) {

                        contenedor.innerHTML =
                            `<img
                                src="${fotosInicioIniciales[id]}"
                                alt="Imagen del producto"
                                class="home-product-image">

                             <button
                                type="button"
                                class="home-image-edit"
                                onclick="seleccionarImagenInicio('${id}')">
                                ✎ Foto
                             </button>`;

                    }
                    else {

                        contenedor.innerHTML =
                            `<span class="home-image-placeholder">Imagen</span>

                             <button
                                type="button"
                                class="home-image-edit"
                                onclick="seleccionarImagenInicio('${id}')">
                                ✎ Foto
                             </button>`;

                    }

                });
            }


            function guardarFotosInicio() {

                localStorage.setItem(
                    CLAVE_INICIO_FOTOS,
                    JSON.stringify(fotosInicioIniciales)
                );
            }


            function seleccionarImagenInicio(id) {

                const input =
                    document.createElement("input");

                input.type = "file";
                input.accept = "image/*";

                input.onchange = async function () {

                    const archivo = this.files[0];

                    if (!archivo) {
                        return;
                    }

                    try {

                        const imagen =
                            await procesarImagen(archivo);

                        fotosInicioIniciales[id] = imagen;

                        guardarFotosInicio();
                        cargarFotosInicio();

                    }
                    catch (error) {

                        console.error(error);

                        alert(
                            "No se pudo guardar la imagen. " +
                            "Prueba con una imagen más pequeña."
                        );
                    }
                };

                input.click();
            }


            async function guardarFotoPerfil(input) {

                const archivo =
                    input.files[0];

                if (!archivo) {
                    return;
                }

                try {

                    const imagen =
                        await procesarImagen(archivo);

                    localStorage.setItem(
                        CLAVE_FOTO_PERFIL,
                        imagen
                    );

                    mostrarFotoPerfil(imagen);

                }
                catch (error) {

                    console.error(error);

                    alert(
                        "No se pudo guardar la foto de perfil. " +
                        "Prueba con una imagen más pequeña."
                    );
                }

                input.value = "";
            }


            function mostrarFotoPerfil(imagen) {

                const foto =
                    document.getElementById("profilePhoto");

                const circulo =
                    document.getElementById("userCircle");

                if (!foto) {
                    return;
                }

                if (imagen) {

                    foto.innerHTML =
                        `<img src="${imagen}" alt="Foto de perfil">`;

                    if (circulo) {
                        circulo.style.backgroundImage =
                            `url("${imagen}")`;
                        circulo.style.backgroundSize = "cover";
                        circulo.style.backgroundPosition = "center";
                        circulo.textContent = "";
                    }

                }
                else {

                    foto.textContent = "@inicial";

                    if (circulo) {
                        circulo.style.backgroundImage = "";
                        circulo.style.backgroundSize = "";
                        circulo.style.backgroundPosition = "";
                        circulo.textContent = "@inicial";
                    }

                }
            }


            function cargarFotoPerfil() {

                const imagen =
                    localStorage.getItem(CLAVE_FOTO_PERFIL) || "";

                mostrarFotoPerfil(imagen);
            }


            function eliminarFotoPerfil() {

                localStorage.removeItem(CLAVE_FOTO_PERFIL);

                mostrarFotoPerfil("");

                const input =
                    document.getElementById("profileImageInput");

                if (input) {
                    input.value = "";
                }
            }


            function mostrarSeccion(nombre, boton) {

                const secciones =
                    document.querySelectorAll(".section");

                secciones.forEach(function (seccion) {
                    seccion.classList.remove("active");
                });

                const destino =
                    document.getElementById(nombre);

                if (destino) {
                    destino.classList.add("active");
                }

                const botones =
                    document.querySelectorAll(".menu-button");

                botones.forEach(function (item) {
                    item.classList.remove("active");
                });

                if (boton) {
                    boton.classList.add("active");
                }
                else {

                    botones.forEach(function (item) {

                        const texto =
                            item.textContent
                                .trim()
                                .toLowerCase();

                        if (
                            (nombre === "inicio" && texto.includes("inicio")) ||
                            (nombre === "pedidos" && texto.includes("pedidos")) ||
                            (nombre === "catalogo" && texto.includes("catálogo")) ||
                            (nombre === "perfil" && texto.includes("perfil"))
                        ) {
                            item.classList.add("active");
                        }

                    });
                }

                if (nombre === "catalogo") {
                    renderizarCatalogo();
                }
            }


            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    cargarCatalogo();
                    cargarFotosInicio();
                    cargarFotoPerfil();

                    const inputImagen =
                        document.getElementById("editorImagen");

                    if (inputImagen) {

                        inputImagen.addEventListener(
                            "change",
                            async function () {

                                const archivo =
                                    this.files[0];

                                if (!archivo) {
                                    actualizarVistaPrevia("");
                                    return;
                                }

                                try {

                                    const imagen =
                                        await procesarImagen(archivo);

                                    actualizarVistaPrevia(imagen);

                                }
                                catch (error) {

                                    alert(
                                        "No se pudo cargar la imagen."
                                    );
                                }
                            }
                        );
                    }
                }
            );

    </script>



</body>

</html>