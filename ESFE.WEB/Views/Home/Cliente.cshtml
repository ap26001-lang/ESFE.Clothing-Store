@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Cliente";
    Layout = null;

    var usuario = ViewBag.Usuario as string ?? "Cliente";

    var inicial = usuario.Length > 0
        ? usuario.Substring(0, 1).ToUpper()
        : "C";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Maison Élite | Cliente
    </title>


    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap"
          rel="stylesheet" />


    <style>

            :root {
                --me-bg-dark: #120b08;
                --me-bg-dark-2: #1c100b;
                --me-bg-cream: #f9f6f0;
                --me-gold: #d4af37;
                --me-gold-hover: #b89228;
                --me-border: #e2d7c3;
                --me-text-dark: #1c1613;
                --me-text-muted: #82756a;
            }


            * {
                box-sizing: border-box;
            }


            html,
            body {
                margin: 0;
                width: 100%;
                height: 100%;
            }


            body {
                background: var(--me-bg-cream);
                color: var(--me-text-dark);
                font-family: 'Montserrat', Arial, sans-serif;
            }


            /* ==========================
                       ESTRUCTURA
                    ========================== */

            .cliente-layout {
                display: flex;
                min-height: 100vh;
                width: 100%;
            }


            /* ==========================
                       MENÚ LATERAL
                    ========================== */

            .sidebar {
                width: 165px;
                min-width: 165px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--me-bg-dark);
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }


            .brand {
                padding: 22px 18px;
                border-bottom: 1px solid rgba(212,175,55,.10);
            }


            .brand-name {
                color: var(--me-gold);
                font-family: 'Playfair Display', serif;
                font-size: 11px;
                letter-spacing: 3px;
                white-space: nowrap;
            }


            .brand-role {
                margin-top: 8px;
                color: #765d4b;
                font-size: 8px;
            }


            .sidebar-menu {
                padding: 17px 8px;
            }


            .menu-button {
                width: 100%;
                height: 34px;
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 0 10px;
                margin-bottom: 5px;
                border: none;
                background: transparent;
                color: #a48d7c;
                font-family: 'Montserrat', sans-serif;
                font-size: 9px;
                text-align: left;
                cursor: pointer;
            }


                .menu-button:hover {
                    background: #21140f;
                    color: #d9c3ae;
                }


                .menu-button.active {
                    background: #2a1812;
                    color: var(--me-gold);
                }


            .menu-icon {
                width: 13px;
                text-align: center;
            }


            .sidebar-bottom {
                border-top: 1px solid rgba(212,175,55,.10);
                padding: 17px 8px 20px;
            }


            .logout {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 0 10px;
                color: #765d4b;
                text-decoration: none;
                font-size: 8px;
            }


                .logout:hover {
                    color: #b38d68;
                }


            /* ==========================
                       CONTENIDO
                    ========================== */

            .main {
                margin-left: 165px;
                width: calc(100% - 165px);
                min-height: 100vh;
                background: #fbfaf7;
            }


            .topbar {
                height: 45px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
                background: white;
                border-bottom: 1px solid var(--me-border);
            }


            .page-title {
                margin: 0;
                font-family: 'Playfair Display', serif;
                font-size: 15px;
                font-weight: 400;
            }


            .user-circle {
                border: none;
                padding: 0;
                cursor: pointer;
                width: 23px;
                height: 23px;
                border-radius: 50%;
                background: #c7a15e;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 9px;
                font-weight: 600;
            }


            .content {
                max-width: 1050px;
                margin: auto;
                padding: 25px 25px 50px;
            }


            /* ==========================
                       SECCIONES
                    ========================== */

            .section {
                display: none;
            }


                .section.active {
                    display: block;
                }


            /* ==========================
                       BIENVENIDA
                    ========================== */

            .welcome {
                background: var(--me-bg-dark);
                color: white;
                padding: 25px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }


            .welcome-small {
                color: var(--me-gold);
                font-size: 8px;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                margin-bottom: 6px;
            }


            .welcome h1 {
                margin: 0;
                font-family: 'Playfair Display', serif;
                font-weight: 400;
                font-size: 28px;
            }


            .welcome p {
                margin: 7px 0 0;
                color: #a88f7e;
                font-size: 8px;
            }


            .stats {
                display: flex;
                gap: 30px;
            }


            .stat {
                text-align: center;
            }


                .stat strong {
                    display: block;
                    color: var(--me-gold);
                    font-family: 'Playfair Display', serif;
                    font-size: 20px;
                }


                .stat span {
                    color: #765d4b;
                    font-size: 7px;
                    text-transform: uppercase;
                }


            /* ==========================
                       TÍTULOS
                    ========================== */

            .section-title {
                margin: 25px 0 10px;
                color: #806e60;
                font-size: 8px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }


            /* ==========================
                       PEDIDO
                    ========================== */

            .order {
                background: white;
                border: 1px solid var(--me-border);
                padding: 18px;
            }


            .order-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 15px;
            }


            .order-id {
                color: #b38858;
                font-size: 8px;
            }


            .status {
                background: #eef8f2;
                color: #3b8769;
                border: 1px solid #bfe2ce;
                padding: 4px 8px;
                font-size: 7px;
            }


            .products {
                display: flex;
                gap: 25px;
                flex-wrap: wrap;
            }


            .product-small {
                display: flex;
                gap: 10px;
                align-items: center;
            }


            .product-image {
                width: 60px;
                height: 60px;
                background: #eee7dd;
                border: 1px solid #ded1c1;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #9d8b7b;
                font-size: 7px;
            }


            .product-name {
                font-size: 8px;
                font-weight: 600;
            }


            .product-size {
                color: #82756a;
                font-size: 7px;
                margin-top: 4px;
            }


            .product-price {
                font-family: 'Playfair Display', serif;
                font-size: 12px;
                margin-top: 4px;
            }


            .order-bottom {
                border-top: 1px solid #eee6dc;
                margin-top: 15px;
                padding-top: 13px;
                display: flex;
                justify-content: space-between;
            }


            .order-date {
                color: #82756a;
                font-size: 8px;
            }


            .order-total {
                font-family: 'Playfair Display', serif;
                font-size: 16px;
            }


            /* ==========================
                       PRODUCTOS
                    ========================== */

            .products-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 10px;
            }


            .card {
                background: white;
                border: 1px solid var(--me-border);
            }


            .card-image {
                height: 140px;
                background: #eee7dd;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #9d8b7b;
                font-size: 8px;
            }


            .card-body {
                padding: 11px;
            }


            .card-name {
                font-size: 8px;
                font-weight: 600;
            }


            .card-price {
                margin-top: 5px;
                font-family: 'Playfair Display', serif;
                font-size: 13px;
            }


            .card-button {
                width: 100%;
                height: 28px;
                margin-top: 10px;
                background: #f8f4ee;
                border: 1px solid var(--me-border);
                color: #604c40;
                font-size: 7px;
                cursor: pointer;
            }


                .card-button:hover {
                    border-color: var(--me-gold);
                    color: #60471f;
                }


            /* ==========================
                       PEDIDOS
                    ========================== */

            .order-list {
                display: flex;
                flex-direction: column;
                gap: 9px;
            }


            .order-row {
                background: white;
                border: 1px solid var(--me-border);
                padding: 15px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }


            .order-row-info {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }


            .order-row-id {
                color: #b38858;
                font-size: 8px;
            }


            .order-row-name {
                font-size: 8px;
            }


            .order-row-date {
                color: #82756a;
                font-size: 7px;
            }


            .order-row-total {
                font-family: 'Playfair Display', serif;
                font-size: 15px;
            }


            /* ==========================
                       PERFIL
                    ========================== */

            .profile {
                background: white;
                border: 1px solid var(--me-border);
                padding: 25px;
            }


                .profile h2 {
                    margin: 0 0 20px;
                    font-family: 'Playfair Display', serif;
                    font-weight: 400;
                    font-size: 21px;
                }


            .profile-row {
                padding: 13px 0;
                border-bottom: 1px solid #eee6dc;
            }


            .profile-label {
                display: block;
                color: #82756a;
                font-size: 7px;
                text-transform: uppercase;
                letter-spacing: .8px;
                margin-bottom: 4px;
            }


            .profile-value {
                font-size: 9px;
            }


            /* ==========================
                       RESPONSIVE
                    ========================== */

            @@media (max-width: 850px) {

                .products-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .welcome {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                }
            }


            @@media (max-width: 600px) {

                .sidebar {
                    width: 130px;
                    min-width: 130px;
                }

                .main {
                    margin-left: 130px;
                    width: calc(100% - 130px);
                }

                .products-grid {
                    grid-template-columns: 1fr;
                }

                .content {
                    padding: 15px;
                }
            }


            /* ==========================
                       EDICIÓN LOCAL DEL CATÁLOGO
                    ========================== */

            .catalog-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 18px;
            }

            .catalog-edit-button {
                border: 1px solid var(--me-gold);
                background: white;
                color: var(--me-text-dark);
                padding: 7px 11px;
                border-radius: 5px;
                font-family: 'Montserrat', Arial, sans-serif;
                font-size: 8px;
                cursor: pointer;
            }

                .catalog-edit-button:hover {
                    background: var(--me-gold);
                    color: white;
                }

            .catalog-card-image {
                height: 280px !important;
                background: #f7f3ed;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

                .catalog-card-image .catalog-product-image {
                    width: 100%;
                    height: 100%;
                    object-fit: contain !important;
                    background: #f7f3ed;
                }

            .product-view-image {
                width: 100%;
                max-height: 360px;
                object-fit: contain;
                background: #f7f3ed;
                border: 1px solid var(--me-border);
            }

            .purchase-summary {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin: 14px 0;
                padding: 12px;
                background: #fbfaf7;
                border: 1px solid var(--me-border);
            }

            .purchase-total {
                font-family: 'Playfair Display', serif;
                font-size: 19px;
                color: var(--me-text-dark);
            }

            .demo-payment-note {
                margin: 0 0 14px;
                padding: 10px 12px;
                background: #f8f2e8;
                border: 1px solid var(--me-border);
                color: var(--me-text-muted);
                font-size: 8px;
                line-height: 1.5;
            }

            .demo-card {
                border: 1px solid var(--me-border);
                background: linear-gradient(135deg, #211610, #4b3526);
                color: #fff;
                padding: 18px;
                min-height: 115px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                margin-bottom: 16px;
            }

            .demo-card-title {
                font-size: 8px;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .demo-card-number {
                font-family: 'Montserrat', Arial, sans-serif;
                font-size: 16px;
                letter-spacing: 2px;
            }

            .demo-success {
                text-align: center;
                padding: 25px 10px;
            }

            .demo-success-icon {
                font-size: 34px;
                margin-bottom: 10px;
            }

            .catalog-card-image {
                overflow: hidden;
                position: relative;
                height: 240px;
            }

                .catalog-card-image .catalog-product-image {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    background: #eee7dd;
                    display: block;
                }

            .home-image {
                position: relative;
                overflow: hidden;
            }

            .home-product-image {
                width: 100%;
                height: 100%;
                object-fit: contain;
                background: #eee7dd;
                display: block;
            }

            .home-image-edit {
                position: absolute;
                right: 7px;
                bottom: 7px;
                border: 1px solid var(--me-border);
                background: rgba(255,255,255,.94);
                color: var(--me-text-dark);
                padding: 5px 7px;
                border-radius: 4px;
                font-family: 'Montserrat', Arial, sans-serif;
                font-size: 8px;
                cursor: pointer;
            }

                .home-image-edit:hover {
                    border-color: var(--me-gold);
                    color: var(--me-gold-hover);
                }

            .profile-header {
                display: flex;
                align-items: center;
                gap: 18px;
                margin-bottom: 22px;
                padding-bottom: 18px;
                border-bottom: 1px solid #eee6dc;
            }

            .profile-photo {
                width: 78px;
                height: 78px;
                min-width: 78px;
                border-radius: 50%;
                background: #eee7dd;
                border: 1px solid var(--me-border);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #9d8b7b;
                font-family: 'Playfair Display', serif;
                font-size: 24px;
                overflow: hidden;
            }

                .profile-photo img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

            .profile-photo-info h3 {
                margin: 0 0 5px;
                font-family: 'Playfair Display', serif;
                font-weight: 400;
                font-size: 17px;
            }

            .profile-photo-info p {
                margin: 0 0 9px;
                color: var(--me-text-muted);
                font-size: 8px;
            }

            .profile-photo-button {
                border: 1px solid var(--me-border);
                background: white;
                color: var(--me-text-dark);
                padding: 6px 9px;
                font-family: 'Montserrat', Arial, sans-serif;
                font-size: 8px;
                cursor: pointer;
            }

                .profile-photo-button:hover {
                    border-color: var(--me-gold);
                    color: var(--me-gold-hover);
                }

            .profile-photo-remove {
                margin-left: 5px;
                color: #9b5b51;
            }

            .profile-image-input {
                display: none;
            }

            .catalog-product-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .catalog-product-placeholder {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .catalog-card-actions {
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 8px;
            }

                .catalog-card-actions .card-button {
                    flex: 1;
                }

            .catalog-edit-small {
                width: 29px;
                height: 29px;
                border: 1px solid var(--me-border);
                background: white;
                color: var(--me-text-muted);
                border-radius: 5px;
                cursor: pointer;
                font-size: 14px;
            }

                .catalog-edit-small:hover {
                    border-color: var(--me-gold);
                    color: var(--me-gold-hover);
                }

            .catalogo-vacio {
                grid-column: 1 / -1;
                background: white;
                border: 1px solid var(--me-border);
                padding: 35px;
                text-align: center;
                color: var(--me-text-muted);
                font-size: 10px;
            }

            .editor-overlay {
                position: fixed;
                inset: 0;
                background: rgba(18, 11, 8, .55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 9999;
                padding: 20px;
            }

            .editor-modal {
                width: min(430px, 100%);
                background: white;
                border: 1px solid var(--me-border);
                padding: 24px;
                box-shadow: 0 12px 35px rgba(0,0,0,.18);
            }

            .editor-modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 18px;
                border-bottom: 1px solid #eee6dc;
                padding-bottom: 12px;
            }

            .editor-modal-title {
                margin: 0;
                font-family: 'Playfair Display', serif;
                font-size: 20px;
                font-weight: 400;
            }

            .editor-close {
                border: none;
                background: transparent;
                color: var(--me-text-muted);
                font-size: 22px;
                cursor: pointer;
            }

            .editor-field {
                margin-bottom: 14px;
            }

                .editor-field label {
                    display: block;
                    margin-bottom: 5px;
                    color: var(--me-text-muted);
                    font-size: 8px;
                    text-transform: uppercase;
                    letter-spacing: .7px;
                }

                .editor-field input {
                    width: 100%;
                    padding: 9px 10px;
                    border: 1px solid var(--me-border);
                    outline: none;
                    font-family: 'Montserrat', Arial, sans-serif;
                    font-size: 9px;
                    color: var(--me-text-dark);
                    background: #fbfaf7;
                }

                    .editor-field input:focus {
                        border-color: var(--me-gold);
                    }

            .editor-preview {
                width: 100%;
                height: 150px;
                border: 1px solid var(--me-border);
                background: #f9f6f0;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                margin-bottom: 14px;
                color: var(--me-text-muted);
                font-size: 8px;
            }

                .editor-preview img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    background: #eee7dd;
                }

            .editor-buttons {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                margin-top: 18px;
            }

            .editor-buttons-right {
                display: flex;
                gap: 8px;
            }

            .editor-button {
                border: 1px solid var(--me-border);
                background: white;
                color: var(--me-text-dark);
                padding: 8px 12px;
                font-family: 'Montserrat', Arial, sans-serif;
                font-size: 8px;
                cursor: pointer;
            }

                .editor-button:hover {
                    border-color: var(--me-gold);
                }

            .editor-button-save {
                background: var(--me-bg-dark);
                border-color: var(--me-bg-dark);
                color: var(--me-gold);
            }

            .editor-button-delete {
                color: #9b5b51;
            }
    </style>

</head>


<body>


    <div class="cliente-layout">


        <!-- ==========================
         MENÚ LATERAL
    =========================== -->

        <aside class="sidebar">

            <div>

                <div class="brand">

                    <div class="brand-name">
                        MAISON ÉLITE
                    </div>

                    <div class="brand-role">
                        Cliente
                    </div>

                </div>


                <nav class="sidebar-menu">

                    <button class="menu-button active"
                            onclick="mostrarSeccion('inicio', this)">

                        <span class="menu-icon">
                            ◉
                        </span>

                        Inicio

                    </button>


                    <button class="menu-button"
                            onclick="mostrarSeccion('pedidos', this)">

                        <span class="menu-icon">
                            ○
                        </span>

                        Mis pedidos

                    </button>


                    <button class="menu-button"
                            onclick="mostrarSeccion('catalogo', this)">

                        <span class="menu-icon">
                            □
                        </span>

                        Catálogo

                    </button>


                    <button class="menu-button"
                            onclick="mostrarSeccion('perfil', this)">

                        <span class="menu-icon">
                            ○
                        </span>

                        Mi perfil

                    </button>

                </nav>

            </div>


            <div class="sidebar-bottom">

                <a class="logout"
                   href="@Url.Action("CerrarSesion", "Login")">

                    ↩

                    Cerrar sesión

                </a>

            </div>

        </aside>


        <!-- ==========================
         CONTENIDO
    =========================== -->

        <main class="main">


            <header class="topbar">

                <h1 class="page-title">
                    Maison Élite
                </h1>


                <button type="button"
                        id="userCircle"
                        class="user-circle"
                        onclick="mostrarSeccion('perfil')"
                        title="Ver mi perfil">
                    @inicial
                </button>

            </header>


            <div class="content">


                <!-- ======================
                 INICIO
            ======================= -->

                <section id="inicio"
                         class="section active">


                    <div class="welcome">

                        <div>

                            <div class="welcome-small">
                                Bienvenida de vuelta
                            </div>

                            <h1>
                                @usuario
                            </h1>

                            <p>
                                Gracias por formar parte de Maison Élite.
                            </p>

                        </div>


                        <div class="stats">

                            <div class="stat">

                                <strong>
                                    9
                                </strong>

                                <span>
                                    Pedidos
                                </span>

                            </div>


                            <div class="stat">

                                <strong>
                                    $24,800
                                </strong>

                                <span>
                                    Compras
                                </span>

                            </div>

                        </div>

                    </div>


