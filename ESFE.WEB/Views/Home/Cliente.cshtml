                <span>Sin imagen</span>
            </div>

            <div class="editor-buttons">

                <button id="btnEliminarProducto"
                        type="button"
                        class="editor-button editor-button-delete"
                        onclick="eliminarProductoLocal()">
                    Eliminar
                </button>

                <div class="editor-buttons-right">

                    <button type="button"
                            class="editor-button"
                            onclick="cerrarEditor()">
                        Cancelar
                    </button>

                    <button type="button"
                            class="editor-button editor-button-save"
                            onclick="guardarProductoLocal()">
                        Guardar
                    </button>

