@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Clientes - Maison Élite";
    Layout = null;
    var usuario = Context.Session.GetString("Usuario") ?? "Administrador";
    var inicial = usuario.Length > 0 ? usuario.Substring(0, 1).ToUpper() : "A";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clientes - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --sidebar-bg: #1c140e;
            --sidebar-hover: #2a1f17;
            --gold-accent: #c4a47c;
            --gold-light: #e5d3b3;
            --bg-main: #f8f6f2;
            --card-bg: #ffffff;
            --text-dark: #2b2b2b;
            --text-muted: #7f7f7f;
            --positive-green: #40826d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-dark);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px 16px;
            color: #d1d1d1;
        }

        .brand-header {
            padding: 0 12px 24px 12px;
            border-bottom: 1px solid rgba(196, 164, 124, 0.15);
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: var(--gold-accent);
            font-size: 1.4rem;
            letter-spacing: 2px;
            font-weight: 600;
        }

        .brand-subtitle {
            font-size: 0.75rem;
            color: var(--gold-light);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            opacity: 0.8;
        }

        .nav-menu {
            list-style: none;
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #b0a8a0;
            text-decoration: none;
            font-size: 0.9rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-item.active a, .nav-item a:hover {
            background-color: var(--sidebar-hover);
            color: #ffffff;
        }

        .nav-item.active a {
            border-left: 3px solid var(--gold-accent);
            color: var(--gold-accent);
        }

        .nav-item i {
            font-size: 1rem;
            width: 20px;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(196, 164, 124, 0.15);
            padding-top: 16px;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #b0a8a0;
            text-decoration: none;
            font-size: 0.9rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background-color: rgba(217, 83, 79, 0.15);
            color: #d9534f;
        }

        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 32px 40px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--text-dark);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background-color: var(--gold-accent);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .metric-card {
            background-color: var(--card-bg);
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .metric-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .metric-value {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .metric-sub {
            font-size: 0.78rem;
            color: var(--positive-green);
            font-weight: 600;
        }

        .btn-gold {
            background-color: var(--sidebar-bg);
            color: var(--gold-accent);
            border: 1px solid var(--gold-accent);
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-gold:hover {
            background-color: var(--gold-accent);
            color: #ffffff;
        }

        .content-card {
            background-color: var(--card-bg);
            padding: 28px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .filter-bar {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .search-input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.9rem;
            outline: none;
        }

        .search-input:focus,
        .filter-select:focus,
        .form-control:focus {
            border-color: var(--gold-accent);
        }

        .filter-select,
        .form-control {
            padding: 10px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.9rem;
            outline: none;
            background: #fff;
            color: var(--text-dark);
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .custom-table th {
            padding: 14px 16px;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            border-bottom: 2px solid #f0f0f0;
        }

        .custom-table td {
            padding: 16px;
            font-size: 0.9rem;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

        .client-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .client-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #f2eee6;
            color: #725b4e;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }

        .client-name {
            font-weight: 600;
            color: var(--text-dark);
        }

        .client-id {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .badge-status,
        .badge-vip {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-status {
            background-color: rgba(64, 130, 109, 0.12);
            color: #40826d;
        }

        .badge-vip {
            background-color: rgba(196, 164, 124, 0.2);
            color: #8c6a38;
        }

        .btn-action {
            background: none;
            border: none;
            color: var(--sidebar-bg);
            cursor: pointer;
            font-size: 1.05rem;
            padding: 6px 8px;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .btn-action:hover {
            background-color: #f0ecf4;
            color: var(--gold-accent);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-container {
            background: #fff;
            width: 480px;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .modal-header h3 {
            font-family: 'Playfair Display', serif;
            color: var(--sidebar-bg);
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--text-dark);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-cancel {
            background: #e5e5e5;
            border: none;
            padding: 9px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            color: #444;
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminCatalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a>
                </li>
                <li class="nav-item active">
                    <a href="@Url.Action("AdminClientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminPuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminHistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminReportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminBitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("AdminRespaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a>
                </li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Gestión de Clientes</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Directorio visual de clientes y seguimiento comercial.</p>
            </div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <button id="btnAbrirModalCliente" class="btn-gold">
                    <i class="fa-solid fa-user-plus"></i> Registrar Cliente
                </button>
                <div class="user-avatar">@inicial</div>
            </div>
        </header>

        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-label">Total Clientes</div>
                <div class="metric-value">1,248</div>
                <div class="metric-sub"><i class="fa-solid fa-arrow-up"></i> +12% este mes</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Clientes VIP</div>
                <div class="metric-value">342</div>
                <div class="metric-sub"><i class="fa-solid fa-crown"></i> 27% del total</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Ingresos Acumulados</div>
                <div class="metric-value">$45,820.00</div>
                <div class="metric-sub"><i class="fa-solid fa-arrow-up"></i> +8.4% vs mes anterior</div>
            </div>
        </div>

        <section class="content-card">
            <div class="filter-bar">
                <input type="text" id="txtBuscarCliente" class="search-input" placeholder="Buscar por nombre, DUI o correo electrónico..." onkeyup="filtrarClientes()" />
                <select id="filtroCategoria" class="filter-select" onchange="filtrarClientes()">
                    <option value="">Todas las categorías</option>
                    <option value="VIP">VIP</option>
                    <option value="Regular">Regular</option>
                    <option value="Nuevo">Nuevo</option>
                </select>
            </div>

            <table class="custom-table" id="tablaClientes">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>DUI / Documento</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Compras</th>
                        <th>Categoría</th>
                        <th style="text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="client-info">
                                <div class="client-avatar">SM</div>
                                <div>
                                    <div class="client-name">Sofía Martínez</div>
                                    <div class="client-id">CLI-001</div>
                                </div>
                            </div>
                        </td>
                        <td>02345678-9</td>
                        <td>+503 7123-4567</td>
                        <td>sofia.martinez@email.com</td>
                        <td><strong>18</strong> pedidos</td>
                        <td><span class="badge-vip">VIP</span></td>
                        <td style="text-align: center;"><button class="btn-action" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="client-info">
                                <div class="client-avatar">CR</div>
                                <div>
                                    <div class="client-name">Carlos Rodríguez</div>
                                    <div class="client-id">CLI-002</div>
                                </div>
                            </div>
                        </td>
                        <td>03456789-1</td>
                        <td>+503 7234-5678</td>
                        <td>carlos.rodriguez@email.com</td>
                        <td><strong>9</strong> pedidos</td>
                        <td><span class="badge-status">Regular</span></td>
                        <td style="text-align: center;"><button class="btn-action" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="client-info">
                                <div class="client-avatar">AG</div>
                                <div>
                                    <div class="client-name">Ana Gómez</div>
                                    <div class="client-id">CLI-003</div>
                                </div>
                            </div>
                        </td>
                        <td>04567890-2</td>
                        <td>+503 7345-6789</td>
                        <td>ana.gomez@email.com</td>
                        <td><strong>24</strong> pedidos</td>
                        <td><span class="badge-vip">VIP</span></td>
                        <td style="text-align: center;"><button class="btn-action" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button></td>
                    </tr>
                    <tr>
                        <td>
                            <div class="client-info">
                                <div class="client-avatar">LH</div>
                                <div>
                                    <div class="client-name">Luis Hernández</div>
                                    <div class="client-id">CLI-004</div>
                                </div>
                            </div>
                        </td>
                        <td>05678901-3</td>
                        <td>+503 7456-7890</td>
                        <td>luis.hernandez@email.com</td>
                        <td><strong>3</strong> pedidos</td>
                        <td><span class="badge-status">Nuevo</span></td>
                        <td style="text-align: center;"><button class="btn-action" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button></td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <div class="modal-overlay" id="modalCliente">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Registrar Nuevo Cliente</h3>
                <button class="close-modal" id="btnCerrarModal">&times;</button>
            </div>
            <form asp-controller="Home" asp-action="GuardarCliente" method="post">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" name="Nombre" class="form-control" placeholder="Ej: Sofía Martínez" required />
                </div>
                <div class="form-group">
                    <label>DUI / Documento</label>
                    <input type="text" name="Dui" class="form-control" placeholder="Ej: 00000000-0" />
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="Correo" class="form-control" placeholder="Ej: correo@ejemplo.com" required />
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="Telefono" class="form-control" placeholder="Ej: +503 7000-0000" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" id="btnCancelarModal">Cancelar</button>
                    <button type="submit" class="btn-gold">Guardar Cliente</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modalCliente = document.getElementById('modalCliente');
        const btnAbrir = document.getElementById('btnAbrirModalCliente');
        const btnCerrar = document.getElementById('btnCerrarModal');
        const btnCancelar = document.getElementById('btnCancelarModal');

        btnAbrir.addEventListener('click', () => {
            modalCliente.style.display = 'flex';
        });

        btnCerrar.addEventListener('click', () => {
            modalCliente.style.display = 'none';
        });

        btnCancelar.addEventListener('click', () => {
            modalCliente.style.display = 'none';
        });

        function filtrarClientes() {
            const input = document.getElementById('txtBuscarCliente').value.toLowerCase();
            const filtroCat = document.getElementById('filtroCategoria').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaClientes tbody tr');

            filas.forEach(fila => {
                const texto = fila.innerText.toLowerCase();
                const coincideTexto = texto.includes(input);
                const coincideCat = filtroCat === '' || texto.includes(filtroCat);
                fila.style.display = coincideTexto && coincideCat ? '' : 'none';
            });
        }
    </script>
</body>
</html>