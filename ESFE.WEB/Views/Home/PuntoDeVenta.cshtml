@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Punto de Venta";
    Layout = null;

    var usuario = Context.Session.GetString("Usuario") ?? "Vendedor";
    var inicial = usuario.Length > 0
        ? usuario.Substring(0, 1).ToUpper()
        : "V";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Punto de Venta | Maison Élite</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <style>

        :root {
            --me-bg-dark: #120b08;
            --me-bg-cream: #f9f6f0;
            --me-gold: #d4af37;
            --me-gold-hover: #b89228;
            --me-border: #e2d7c3;
            --me-text-dark: #1c1613;
            --me-text-muted: #82756a;
        }


        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
        }


        body {
            background: var(--me-bg-cream);
            color: var(--me-text-dark);
            font-family: 'Montserrat', Arial, sans-serif;
            overflow: hidden;
        }


        /* =========================================
           ESTRUCTURA
        ========================================= */

        .seller-layout {
            display: flex;
            width: 100%;
            height: 100vh;
        }


        /* =========================================
           SIDEBAR
        ========================================= */

        .sidebar {
            width: 160px;
            min-width: 160px;
            height: 100vh;

            background: var(--me-bg-dark);
            color: white;

            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }


        .brand {
            padding: 20px 18px 22px;

            border-bottom:
                1px solid rgba(212,175,55,.10);
        }


        .brand-name {
            color: var(--me-gold);

            font-family: 'Playfair Display', serif;

            font-size: 10px;

            letter-spacing: 3px;

            white-space: nowrap;
        }


        .brand-role {
            margin-top: 8px;

            color: #765d4b;

            font-size: 8px;
        }


        .sidebar-menu {
            padding: 16px 10px;

            flex: 1;
        }


        .menu-link {
            display: flex;
            align-items: center;

            gap: 9px;

            height: 31px;

            padding: 0 10px;

            margin-bottom: 5px;

            color: #a48d7c;

            text-decoration: none;

            font-size: 9px;

            transition: .2s;
        }


        .menu-link:hover {
            background: #21140f;

            color: #d9c3ae;
        }


        .menu-link.active {
            background: #2a1812;

            color: var(--me-gold);
        }


        .menu-icon {
            width: 11px;

            text-align: center;

            font-size: 10px;
        }


        .sidebar-bottom {
            padding: 17px 10px 20px;

            border-top:
                1px solid rgba(212,175,55,.10);
        }


        .logout-link {
            display: flex;

            align-items: center;

            gap: 9px;

            padding: 0 10px;

            color: #765d4b;

            text-decoration: none;

            font-size: 8px;
        }


        .logout-link:hover {
            color: #b38d68;
        }


        /* =========================================
           CONTENIDO
        ========================================= */

        .main {
            flex: 1;

            min-width: 0;

            height: 100vh;

            background: #fbfaf7;

            overflow: hidden;
        }


        .topbar {
            height: 43px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 17px;

            background: white;

            border-bottom:
                1px solid var(--me-border);
        }


        .page-title {
            margin: 0;

            font-family:
                'Playfair Display', serif;

            font-size: 14px;

            font-weight: 400;

            color: #2c1d17;
        }


        .user-circle {
            width: 22px;
            height: 22px;

            border-radius: 50%;

            background: #c7a15e;

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 9px;

            font-weight: 600;
        }


        .content {
            display: grid;

            grid-template-columns:
                minmax(500px, 1fr) 342px;

            gap: 16px;

            height: calc(100vh - 43px);

            padding: 20px;
        }


        /* =========================================
           PARTE IZQUIERDA
        ========================================= */

        .products-section {
            min-width: 0;

            overflow: hidden;
        }


        .search-box {
            width: 100%;

            height: 29px;

            padding: 0 11px;

            border:
                1px solid var(--me-border);

            background: white;

            outline: none;

            font-family:
                'Montserrat', sans-serif;

            font-size: 8px;

            color: #34251e;

            margin-bottom: 10px;
        }


        .search-box:focus {
            border-color: #c6a56d;
        }


        /* =========================================
           PRODUCTOS
        ========================================= */

        .products-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 9px;

            max-height: calc(100vh - 110px);

            overflow-y: auto;

            padding-right: 2px;
        }


        .product-card {
            height: 86px;

            background: white;

            border:
                1px solid var(--me-border);

            padding: 11px;

            cursor: pointer;

            transition:
                transform .15s,
                border-color .15s,
                box-shadow .15s;
        }


        .product-card:hover {
            border-color: #c5a46d;

            transform: translateY(-1px);

            box-shadow:
                0 3px 12px rgba(40,25,15,.07);
        }


        .product-code {
            color: #8b7768;

            font-size: 7px;

            letter-spacing: 1px;

            text-transform: uppercase;

            margin-bottom: 3px;
        }


        .product-name {
            color: #241711;

            font-size: 9px;

            font-weight: 600;

            margin-bottom: 4px;
        }


        .product-price {
            color: #241711;

            font-family:
                'Playfair Display', serif;

            font-size: 13px;

            margin-bottom: 5px;
        }


        .product-stock {
            color: #5d947e;

            font-size: 7px;
        }


        .product-stock.low {
            color: #b75c4e;
        }


        /* =========================================
           COLUMNA DERECHA
        ========================================= */

        .sale-section {
            min-width: 0;

            display: flex;

            flex-direction: column;

            gap: 10px;
        }


        .client-box {
            background: white;

            border:
                1px solid var(--me-border);

            padding: 13px;

            height: 72px;
        }


        .section-label {
            display: block;

            color: #806e60;

            font-size: 7px;

            letter-spacing: .8px;

            text-transform: uppercase;

            margin-bottom: 6px;
        }


        .client-select {
            width: 100%;

            height: 28px;

            border:
                1px solid #dfd2c2;

            background: #fff;

            padding: 0 9px;

            outline: none;

            font-family:
                'Montserrat', sans-serif;

            font-size: 8px;

            color: #33251e;
        }


        /* =========================================
           CARRITO
        ========================================= */

        .cart-box {
            flex: 1;

            min-height: 200px;

            background: white;

            border:
                1px solid var(--me-border);

            display: flex;

            flex-direction: column;

            overflow: hidden;
        }


        .cart-title {
            margin: 0;

            padding: 14px;

            font-family:
                'Playfair Display', serif;

            font-size: 14px;

            font-weight: 400;

            color: #2a1c16;

            border-bottom:
                1px solid #eee6dc;
        }


        .cart-items {
            flex: 1;

            overflow-y: auto;

            padding: 4px 10px;
        }


        .empty-cart {
            height: 100%;

            min-height: 100px;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            color: #9b8c81;

            font-size: 8px;
        }


        .cart-item {
            display: grid;

            grid-template-columns:
                1fr auto;

            gap: 8px;

            padding: 10px 4px;

            border-bottom:
                1px solid #eee6dc;
        }


        .cart-item-name {
            color: #271913;

            font-size: 8px;

            font-weight: 600;
        }


        .cart-item-price {
            color: #806e60;

            font-size: 7px;

            margin-top: 3px;
        }


        .cart-item-right {
            text-align: right;
        }


        .cart-item-total {
            font-family:
                'Playfair Display', serif;

            font-size: 10px;

            color: #241711;

            margin-bottom: 4px;
        }


        .quantity-controls {
            display: flex;

            align-items: center;

            justify-content: flex-end;

            gap: 4px;
        }


        .quantity-btn {
            width: 17px;
            height: 17px;

            padding: 0;

            border:
                1px solid #dfd2c2;

            background: #f8f4ee;

            color: #604c40;

            cursor: pointer;

            font-size: 9px;
        }


        .quantity-number {
            min-width: 15px;

            text-align: center;

            font-size: 8px;
        }

                .custom-table td {
                    padding: 12px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                    vertical-align: middle;
                }

            .input-qty {
                width: 50px;
                padding: 4px 8px;
                border: 1px solid #ddd;
                border-radius: 6px;
                text-align: center;
                font-weight: 600;
            }

            .summary-title {
                font-weight: 700;
                font-size: 1.1rem;
                margin-bottom: 16px;
                border-bottom: 1px solid #f0f0f0;
                padding-bottom: 8px;
            }


        .total-line {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 10px;
        }


        .total-label {
            color: #806653;

            font-size: 7px;

            letter-spacing: 1px;

            text-transform: uppercase;
        }


        .total-value {
            color: var(--me-gold);

            font-family:
                'Playfair Display', serif;

            font-size: 17px;
        }


        .finish-sale {
            width: 100%;

            height: 32px;

            border: 0;

            background: #2b1912;

            color: #684e3e;

            font-family:
                'Montserrat', sans-serif;

            font-size: 8px;

            cursor: not-allowed;
        }


        .finish-sale.enabled {
            background: #3a2117;

            color: var(--me-gold);

            cursor: pointer;
        }


        .finish-sale.enabled:hover {
            background: #4a281b;
        }


        /* =========================================
           MODAL DE VENTA
        ========================================= */

        .sale-modal-overlay {
            position: fixed;

            inset: 0;

            display: none;

            align-items: center;

            justify-content: center;

            background:
                rgba(20,14,11,.55);

            z-index: 1000;
        }


        .sale-modal-overlay.show {
            display: flex;
        }


        .sale-modal {
            width: 390px;

            max-width:
                calc(100vw - 30px);

            background: #fbf8f2;

            border:
                1px solid #dfd1c0;

            box-shadow:
                0 15px 50px rgba(0,0,0,.2);
        }


        .sale-modal-header {
            padding: 18px 20px 10px;
        }


        .sale-modal-title {
            margin: 0;

            font-family:
                'Playfair Display', serif;

            font-size: 20px;

            font-weight: 400;
        }


        .sale-modal-body {
            padding: 5px 20px 15px;
        }


        .sale-summary {
            padding: 12px;

            background: white;

            border:
                1px solid var(--me-border);

            font-size: 9px;

            line-height: 1.8;
        }


        .sale-modal-footer {
            display: flex;

            justify-content: flex-end;

            gap: 8px;

            padding:
                10px 20px 18px;
        }


        .modal-btn {
            height: 29px;

            min-width: 90px;

            cursor: pointer;

            font-family:
                'Montserrat', sans-serif;

            font-size: 8px;
        }


        .modal-cancel {
            border:
                1px solid #dfd1c0;

            background: #f4efe7;

            color: #604c40;
        }


        .modal-confirm {
            border:
                1px solid #20120d;

            background: var(--me-bg-dark);

            color: var(--me-gold);
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media (max-width: 900px) {

            .content {
                grid-template-columns: 1fr;
                overflow-y: auto;
            }

            .sale-section {
                min-height: 500px;
            }

        }


        @@media (max-width: 600px) {

            .sidebar {
                width: 125px;
                min-width: 125px;
            }

            .content {
                padding: 12px;
            }

            .products-grid {
                grid-template-columns: 1fr;
            }

                .btn-checkout:hover {
                    background-color: var(--gold-accent);
                    color: #ffffff;
                }

            /* --- ESTILOS MODAL PAGO --- */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            }

            .modal-container {
                background: #fff;
                width: 440px;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #eee;
                padding-bottom: 12px;
                margin-bottom: 16px;
            }

                .modal-header h3 {
                    font-family: 'Playfair Display', serif;
                    color: var(--sidebar-bg);
                }

            .close-modal {
                background: none;
                border: none;
                font-size: 1.2rem;
                cursor: pointer;
                color: var(--text-muted);
            }

            .form-group {
                margin-bottom: 14px;
            }

                .form-group label {
                    display: block;
                    font-size: 0.8rem;
                    font-weight: 600;
                    margin-bottom: 6px;
                    color: var(--text-dark);
                }

            .form-control {
                width: 100%;
                padding: 10px 12px;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 0.9rem;
            }

            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                margin-top: 20px;
            }

            .btn-cancel {
                background: #e0e0e0;
                border: none;
                padding: 10px 16px;
                border-radius: 6px;
                cursor: pointer;
            }
    </style>

</head>


<body>

<div class="seller-layout">


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="sidebar">

        <div>

            <div class="brand">

                <div class="brand-name">
                    MAISON ÉLITE
                </div>

                <div class="brand-role">
                    Vendedor
                </div>

            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item active"><a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="@Url.Action("Reportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item"><a href="@Url.Action("Bitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item"><a href="@Url.Action("Respaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>


        <div class="sidebar-bottom">

            <a class="logout-link"
               href="@Url.Action("Index", "Home")">

                ↩

                Cerrar sesión

            </a>

        </div>

    </aside>



    <!-- =========================================
         CONTENIDO PRINCIPAL
    ========================================== -->

    <main class="main">


        <!-- TOPBAR -->

        <header class="topbar">

            <h1 class="page-title">
                Punto de Venta
            </h1>


            <div class="user-circle">
                @inicial
            </div>

        </header>

        <div class="pos-grid">
            <section class="content-card">
                <input type="text" id="txtBuscarPrenda" class="search-box" placeholder="Buscar prenda por código o nombre..." onkeyup="filtrarPrendas()" />
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Prenda</th>
                            <th>Precio</th>
                            <th>Cant.</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyPOS">
                        <tr data-codigo="PRD-001" data-precio="250.00">
                            <td>Blazer Cachemira <br><small style="color:var(--text-muted);">#PRD-001</small></td>
                            <td>$250.00</td>
                            <td><input type="number" class="input-qty" value="1" min="1" onchange="recalcular()"></td>
                            <td class="col-subtotal">$250.00</td>
                            <td><i class="fa-solid fa-trash" style="color: #c94a4a; cursor: pointer;" onclick="eliminarFila(this)"></i></td>
                        </tr>
                        <tr data-codigo="PRD-002" data-precio="243.00">
                            <td>Vestido Seda Italiana <br><small style="color:var(--text-muted);">#PRD-002</small></td>
                            <td>$243.00</td>
                            <td><input type="number" class="input-qty" value="1" min="1" onchange="recalcular()"></td>
                            <td class="col-subtotal">$243.00</td>
                            <td><i class="fa-solid fa-trash" style="color: #c94a4a; cursor: pointer;" onclick="eliminarFila(this)"></i></td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="content-card">
                <div class="summary-title">Resumen de Venta</div>
                <div class="summary-row"><span>Subtotal</span> <span id="lblSubtotal">$493.00</span></div>
                <div class="summary-row"><span>IVA (13%)</span> <span id="lblIva">$64.09</span></div>
                <div class="summary-row summary-total"><span>Total</span> <span id="lblTotal">$557.09</span></div>
                <button class="btn-checkout" id="btnAbrirCobro"><i class="fa-solid fa-credit-card"></i> Procesar Pago</button>
            </section>
        </div>
    </main>

    <!-- MODAL PROCESAR VENTA -->
    <div class="modal-overlay" id="modalCobro">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Completar Venta</h3>
                <button class="close-modal" id="btnCerrarModal">&times;</button>
            </div>
            <form asp-controller="Home" asp-action="ProcesarVenta" method="post">
                <div class="form-group">
                    <label>Cliente</label>
                    <select name="ClienteId" class="form-control" required>
                        <option value="1">Sofía Martínez (#CLI-001)</option>
                        <option value="2">Carlos Gómez (#CLI-002)</option>
                        <option value="0">Cliente Final (Consumidor Final)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Método de Pago</label>
                    <select name="MetodoPago" class="form-control" required>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta de Crédito / Débito</option>
                        <option value="Transferencia">Transferencia Bancaria</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Monto Total a Cobrar</label>
                    <input type="text" id="txtTotalModal" class="form-control" value="$557.09" readonly style="font-weight: bold; background-color: #f0f0f0;" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" id="btnCancelarModal">Cancelar</button>
                    <button type="submit" class="btn-checkout" style="width: auto; margin-top: 0;">Confirmar Venta</button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT BUSCADOR, CÁLCULOS Y MODAL -->
    <script>
            function filtrarPrendas() {
                const input = document.getElementById('txtBuscarPrenda').value.toLowerCase();
                const filas = document.querySelectorAll('#tbodyPOS tr');

                filas.forEach(fila => {
                    const textoFila = fila.innerText.toLowerCase();
                    if (textoFila.includes(input)) {
                        fila.style.display = '';
                    } else {
                        fila.style.display = 'none';
                    }
                });
            }

            function recalcular() {
                const filas = document.querySelectorAll('#tbodyPOS tr');
                let subtotalGlobal = 0;

                filas.forEach(fila => {
                    if (fila.style.display !== 'none') {
                        const precio = parseFloat(fila.getAttribute('data-precio')) || 0;
                        const cantInput = fila.querySelector('.input-qty');
                        const cant = parseInt(cantInput.value) || 1;

                        const subtotalFila = precio * cant;
                        fila.querySelector('.col-subtotal').innerText = '$' + subtotalFila.toFixed(2);

                        subtotalGlobal += subtotalFila;
                    }
                });

                const iva = subtotalGlobal * 0.13;
                const total = subtotalGlobal + iva;

                document.getElementById('lblSubtotal').innerText = '$' + subtotalGlobal.toFixed(2);
                document.getElementById('lblIva').innerText = '$' + iva.toFixed(2);
                document.getElementById('lblTotal').innerText = '$' + total.toFixed(2);
                document.getElementById('txtTotalModal').value = '$' + total.toFixed(2);
            }

            function eliminarFila(btn) {
                const fila = btn.closest('tr');
                fila.remove();
                recalcular();
            }

            const modalCobro = document.getElementById('modalCobro');
            const btnAbrir = document.getElementById('btnAbrirCobro');
            const btnCerrar = document.getElementById('btnCerrarModal');
            const btnCancelar = document.getElementById('btnCancelarModal');

            btnAbrir.addEventListener('click', () => {
                modalCobro.style.display = 'flex';
            });

            btnCerrar.addEventListener('click', () => {
                modalCobro.style.display = 'none';
            });

            btnCancelar.addEventListener('click', () => {
                modalCobro.style.display = 'none';
            });
    </script>
</body>
</html>