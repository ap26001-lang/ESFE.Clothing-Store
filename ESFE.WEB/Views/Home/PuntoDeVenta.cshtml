@{
    ViewData["Title"] = "Punto de Venta - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Punto de Venta - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .pos-grid {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 24px;
            }

            .content-card {
                background-color: var(--card-bg);
                padding: 24px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .search-box {
                width: 100%;
                padding: 12px 16px;
                border: 1px solid #e0e0e0;
                border-radius: 8px;
                font-size: 0.9rem;
                margin-bottom: 20px;
                outline: none;
            }

                .search-box:focus {
                    border-color: var(--gold-accent);
                }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

                .custom-table th {
                    padding: 12px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 12px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }

            .summary-title {
                font-weight: 700;
                font-size: 1.1rem;
                margin-bottom: 16px;
                border-bottom: 1px solid #f0f0f0;
                padding-bottom: 8px;
            }

            .summary-row {
                display: flex;
                justify-content: space-between;
                margin-bottom: 12px;
                font-size: 0.95rem;
            }

            .summary-total {
                font-weight: 700;
                font-size: 1.2rem;
                color: var(--sidebar-bg);
                border-top: 2px solid #f0f0f0;
                padding-top: 12px;
            }

            .btn-checkout {
                width: 100%;
                background-color: var(--sidebar-bg);
                color: var(--gold-accent);
                border: 1px solid var(--gold-accent);
                padding: 12px;
                border-radius: 8px;
                font-weight: 700;
                cursor: pointer;
                margin-top: 20px;
                transition: all 0.2s;
            }

                .btn-checkout:hover {
                    background-color: var(--gold-accent);
                    color: #ffffff;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item active"><a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="#"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item"><a href="#"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item"><a href="#"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Punto de Venta (POS)</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Módulo de caja y facturación rápida en tienda.</p>
            </div>
        </header>

        <div class="pos-grid">
            <section class="content-card">
                <input type="text" class="search-box" placeholder="Buscar prenda por código o nombre..." />
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Prenda</th>
                            <th>Precio</th>
                            <th>Cant.</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Blazer Cachemira</td>
                            <td>$250.00</td>
                            <td>1</td>
                            <td>$250.00</td>
                            <td><i class="fa-solid fa-trash" style="color: #c94a4a; cursor: pointer;"></i></td>
                        </tr>
                        <tr>
                            <td>Vestido Seda Italiana</td>
                            <td>$243.00</td>
                            <td>1</td>
                            <td>$243.00</td>
                            <td><i class="fa-solid fa-trash" style="color: #c94a4a; cursor: pointer;"></i></td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="content-card">
                <div class="summary-title">Resumen de Venta</div>
                <div class="summary-row"><span>Subtotal</span> <span>$493.00</span></div>
                <div class="summary-row"><span>IVA (13%)</span> <span>$64.09</span></div>
                <div class="summary-row summary-total"><span>Total</span> <span>$557.09</span></div>
                <button class="btn-checkout"><i class="fa-solid fa-credit-card"></i> Procesar Pago</button>
            </section>
        </div>
    </main>

</body>
</html>
