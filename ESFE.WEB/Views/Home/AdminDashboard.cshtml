@{
    ViewData["Title"] = "Dashboard - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Maison Élite</title>
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Chart.js para gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
                --positive-green: #40826d;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* --- SIDEBAR LATERAL --- */
            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

            .nav-item.active a, .nav-item a:hover {
                background-color: var(--sidebar-hover);
                color: #ffffff;
            }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s;
            }

            .logout-btn:hover {
                background-color: rgba(217, 83, 79, 0.15);
                color: #d9534f;
            }

            /* --- CONTENIDO PRINCIPAL --- */
            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 28px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background-color: var(--gold-accent);
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
            }

            /* --- TARJETAS DE MÉTRICAS --- */
            .metrics-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
            }

            .metric-card {
                background-color: var(--card-bg);
                padding: 24px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .metric-label {
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--text-muted);
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .metric-value {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                font-weight: 600;
                color: var(--text-dark);
            }

            .metric-sub {
                font-size: 0.78rem;
                color: var(--positive-green);
                font-weight: 600;
            }

            .metric-sub.negative {
                color: #d9534f;
            }

            /* --- SECCIÓN DE SEGUNDO NIVEL (GRÁFICA + TOP PRODUCTOS) --- */
            .dashboard-details {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 24px;
            }

            .chart-card, .table-card {
                background-color: var(--card-bg);
                padding: 24px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .card-title {
                font-size: 1.05rem;
                font-weight: 600;
                color: var(--text-dark);
            }

            .card-subtitle {
                font-size: 0.8rem;
                color: var(--text-muted);
            }

            /* TABLA TOP PRODUCTOS */
            .products-list {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .product-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 12px;
                border-bottom: 1px solid #f0f0f0;
            }

            .product-item:last-child {
                border-bottom: none;
            }

            .product-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .product-rank {
                width: 24px;
                height: 24px;
                background-color: var(--bg-main);
                border-radius: 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--gold-accent);
            }

            .product-name {
                font-size: 0.88rem;
                font-weight: 500;
            }

            .product-units {
                font-size: 0.75rem;
                color: var(--text-muted);
            }

            .product-price {
                font-weight: 600;
                font-size: 0.9rem;
            }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item active">
                    <a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-chart-pie"></i> Reportes</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-list-check"></i> Bitácora</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-shield-halved"></i> Respaldos</a>
                </li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <header class="header-bar">
            <h1 class="page-title">Dashboard</h1>
            <div class="user-avatar">A</div>
        </header>

        <!-- TARJETAS -->
        <section class="metrics-grid">
            <div class="metric-card">
                <span class="metric-label">VENTAS DEL MES</span>
                <span class="metric-value">$248,350</span>
                <span class="metric-sub">+12.4% vs mes anterior</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">GANANCIA NETA</span>
                <span class="metric-value">$89,620</span>
                <span class="metric-sub">+8.1% vs mes anterior</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">PRODUCTOS ACTIVOS</span>
                <span class="metric-value">184</span>
                <span class="metric-sub negative">-5 vs mes anterior</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">CLIENTES REGISTRADOS</span>
                <span class="metric-value">1,247</span>
                <span class="metric-sub">+28 vs mes anterior</span>
            </div>
        </section>

        <!-- DETALLES Y GRÁFICOS -->
        <section class="dashboard-details">
            <!-- GRÁFICA -->
            <div class="chart-card">
                <div class="card-header">
                    <div>
                        <div class="card-title">Ingresos vs Costos</div>
                        <div class="card-subtitle">Últimos 9 meses · Miles $</div>
                    </div>
                </div>
                <div style="height: 260px;">
                    <canvas id="incomeChart"></canvas>
                </div>
            </div>

            <!-- TOP PRODUCTOS -->
            <div class="table-card">
                <div class="card-header">
                    <div class="card-title">Top Productos</div>
                </div>
                <div class="products-list">
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-rank">1</div>
                            <div>
                                <div class="product-name">Blazer Cachem...</div>
                                <div class="product-units">84 uds.</div>
                            </div>
                        </div>
                        <div class="product-price">$21,000</div>
                    </div>
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-rank">2</div>
                            <div>
                                <div class="product-name">Vestido Seda I...</div>
                                <div class="product-units">77 uds.</div>
                            </div>
                        </div>
                        <div class="product-price">$18,720</div>
                    </div>
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-rank">3</div>
                            <div>
                                <div class="product-name">Abrigo Lana ...</div>
                                <div class="product-units">61 uds.</div>
                            </div>
                        </div>
                        <div class="product-price">$30,500</div>
                    </div>
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-rank">4</div>
                            <div>
                                <div class="product-name">Pantalón Twee...</div>
                                <div class="product-units">58 uds.</div>
                            </div>
                        </div>
                        <div class="product-price">$11,600</div>
                    </div>
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-rank">5</div>
                            <div>
                                <div class="product-name">Blusa Lino Cre...</div>
                                <div class="product-units">49 uds.</div>
                            </div>
                        </div>
                        <div class="product-price">$7,350</div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- SCRIPT GRÁFICA -->
    <script>
            const ctx = document.getElementById('incomeChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'],
                    datasets: [
                        {
                            label: 'Ingresos',
                            data: [180, 200, 220, 210, 240, 230, 250, 240, 248],
                            backgroundColor: '#c4a47c',
                            borderRadius: 4
                        },
                        {
                            label: 'Costos',
                            data: [100, 110, 130, 120, 140, 130, 150, 145, 158],
                            backgroundColor: '#e5d3b3',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', align: 'end' }
                    },
                    scales: {
                        y: { grid: { color: '#f0f0f0' }, border: { dash: [4, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });
    </script>
</body>
</html>