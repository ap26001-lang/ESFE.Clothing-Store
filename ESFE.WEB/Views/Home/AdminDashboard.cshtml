@{
    ViewData["Title"] = "Panel de Administración - Maison Élite";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Panel de Administración - Maison Élite</h2>
        <span class="badge bg-dark fs-6">Sesión: admin@maisonelite.com</span>
    </div>

    <!-- TARJETAS DE MÓDULOS -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <h5 class="fw-bold mb-2">Catálogo de Prendas</h5>
                <p class="text-muted small">Gestión de inventario, tallas y precios.</p>
                <button class="btn btn-dark btn-sm">Ver Catálogo</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <h5 class="fw-bold mb-2">Ventas y Pedidos</h5>
                <p class="text-muted small">Control de transacciones y pedidos en tienda.</p>
                <button class="btn btn-dark btn-sm">Ver Registro</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <h5 class="fw-bold mb-2">Usuarios</h5>
                <p class="text-muted small">Administración de credenciales y roles.</p>
                <button class="btn btn-dark btn-sm">Gestionar Usuarios</button>
            </div>
        </div>
    </div>
</div>