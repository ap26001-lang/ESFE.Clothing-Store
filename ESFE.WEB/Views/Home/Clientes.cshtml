@{
    ViewData["Title"] = "Clientes - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Clientes - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .btn-gold {
                background-color: var(--sidebar-bg);
                color: var(--gold-accent);
                border: 1px solid var(--gold-accent);
                padding: 10px 18px;
                border-radius: 8px;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .btn-gold:hover {
                    background-color: var(--gold-accent);
                    color: #ffffff;
                }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                margin-top: 12px;
            }

                .custom-table th {
                    padding: 14px 16px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a>
                </li>
                <li class="nav-item active">
                    <a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-chart-pie"></i> Reportes</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-list-check"></i> Bitácora</a>
                </li>
                <li class="nav-item">
                    <a href="#"><i class="fa-solid fa-shield-halved"></i> Respaldos</a>
                </li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Clientes Registrados</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Directorio de clientes de la tienda.</p>
            </div>
            <a href="#" class="btn-gold"><i class="fa-solid fa-user-plus"></i> Registrar Cliente</a>
        </header>

        <section class="content-card">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Compras</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#CLI-001</td>
                        <td><strong>Sofía Martínez</strong></td>
                        <td>sofia@email.com</td>
                        <td>+503 7123-4567</td>
                        <td>12 pedidos</td>
                    </tr>
                    <tr>
                        <td>#CLI-002</td>
                        <td><strong>Carlos Gómez</strong></td>
                        <td>carlos.g@email.com</td>
                        <td>+503 7890-1234</td>
                        <td>5 pedidos</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

</body>
</html>
