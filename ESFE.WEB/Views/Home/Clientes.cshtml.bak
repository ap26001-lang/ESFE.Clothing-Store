@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Clientes";
    Layout = null;

    var usuario = Context.Session.GetString("Usuario") ?? "Vendedor";
    var inicial = usuario.Length > 0 ? usuario.Substring(0, 1).ToUpper() : "V";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Clientes | Maison Élite</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
        :root {
            --me-bg-dark: #120b08;
            --me-bg-dark-2: #1c100b;
            --me-bg-cream: #f9f6f0;
            --me-gold: #d4af37;
            --me-gold-hover: #b89228;
            --me-input-bg: #f2eee6;
            --me-border: #e2d7c3;
            --me-text-dark: #1c1613;
            --me-text-muted: #82756a;
            --me-danger: #eaa8a0;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
        }

        body {
            background: var(--me-bg-cream);
            color: var(--me-text-dark);
            font-family: 'Montserrat', Arial, sans-serif;
            overflow: hidden;
        }

        /* =========================
           ESTRUCTURA
        ========================= */

        .seller-layout {
            display: flex;
            width: 100%;
            height: 100vh;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            width: 156px;
            min-width: 156px;
            height: 100vh;
            background: var(--me-bg-dark);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand {
            padding: 21px 18px 22px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.10);
        }

        .brand-name {
            color: var(--me-gold);
            font-family: 'Playfair Display', serif;
            font-size: 10px;
            letter-spacing: 3px;
            white-space: nowrap;
        }

        .brand-role {
            margin-top: 8px;
            color: #765d4b;
            font-size: 8px;
        }

        .sidebar-menu {
            padding: 16px 7px;
            flex: 1;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 9px;
            height: 30px;
            padding: 0 10px;
            margin-bottom: 5px;
            color: #a48d7c;
            text-decoration: none;
            font-size: 9px;
            transition: .2s;
        }

        .menu-link:hover {
            background: #21140f;
            color: #d9c3ae;
        }

        .menu-link.active {
            background: #2a1812;
            color: var(--me-gold);
        }

        .menu-icon {
            width: 11px;
            text-align: center;
            font-size: 10px;
        }

        .sidebar-bottom {
            border-top: 1px solid rgba(212, 175, 55, 0.10);
            padding: 17px 7px 20px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0 10px;
            color: #765d4b;
            text-decoration: none;
            font-size: 8px;
        }

        .logout-link:hover {
            color: #b38d68;
        }

        /* =========================
           CONTENIDO
        ========================= */

        .main {
            flex: 1;
            min-width: 0;
            height: 100vh;
            overflow-y: auto;
            background: #fbfaf7;
        }

        .topbar {
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 17px;
            background: #fff;
            border-bottom: 1px solid var(--me-border);
        }

        .page-title {
            margin: 0;
            font-family: 'Playfair Display', serif;
            font-size: 14px;
            font-weight: 400;
            color: #2c1d17;
        }

            .btn-gold {
                background-color: var(--sidebar-bg);
                color: var(--gold-accent);
                border: 1px solid var(--gold-accent);
                padding: 10px 18px;
                border-radius: 8px;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
            }

        .search-box {
            flex: 1;
            height: 26px;
            border: 1px solid var(--me-border);
            background: #fff;
            padding: 0 11px;
            outline: none;
            font-family: 'Montserrat', sans-serif;
            font-size: 8px;
            color: var(--me-text-dark);
        }

        .search-box:focus {
            border-color: #c7aa78;
        }

        .filter-select {
            width: 76px;
            height: 26px;
            border: 1px solid var(--me-border);
            background: #fff;
            padding: 0 7px;
            outline: none;
            font-size: 8px;
            color: #4b3930;
        }

        .btn-primary {
            height: 26px;
            padding: 0 13px;
            border: 1px solid #20120d;
            background: var(--me-bg-dark);
            color: var(--me-gold);
            font-family: 'Montserrat', sans-serif;
            font-size: 8px;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-primary:hover {
            background: #24150f;
        }

        /* =========================
           TABLA
        ========================= */

        .table-container {
            background: #fff;
            border: 1px solid var(--me-border);
            overflow-x: auto;
        }

        .clients-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        .clients-table thead {
            background: #fff;
        }

        .clients-table th {
            height: 29px;
            padding: 0 13px;
            text-align: left;
            border-bottom: 1px solid var(--me-border);
            color: #806e60;
            font-size: 7px;
            letter-spacing: .8px;
            font-weight: 500;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .clients-table td {
            height: 41px;
            padding: 5px 13px;
            border-bottom: 1px solid #eee6db;
            color: #403029;
            font-size: 8px;
            white-space: nowrap;
        }

        .clients-table tbody tr:hover {
            background: #fcfaf6;
        }

        .client-cell {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .avatar {
            width: 20px;
            height: 20px;
            min-width: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1ece3;
            color: #927d6c;
            font-size: 7px;
            font-weight: 600;
        }

        .avatar.dark {
            background: var(--me-bg-dark);
            color: white;
        }

        .client-name {
            font-weight: 600;
            color: #211712;
            font-size: 8px;
        }

        .client-email {
            margin-top: 2px;
            color: #9b8c81;
            font-size: 7px;
        }

        .number-center {
            text-align: center !important;
        }

        .money {
            font-family: 'Playfair Display', serif;
            font-size: 11px !important;
            color: #2a1c16 !important;
        }

        /* =========================
           CATEGORIAS
        ========================= */

        .category {
            display: inline-block;
            padding: 2px 7px;
            font-size: 7px;
            border-radius: 1px;
        }

        .category.vip {
            background: var(--me-bg-dark);
            color: white;
        }

        .category.regular {
            background: #f0e9df;
            color: #765d4b;
        }

        .category.nuevo {
            background: #eef3ff;
            color: #4b6fa8;
        }

        /* =========================
           BOTONES TABLA
        ========================= */

        .actions {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .btn-edit,
        .btn-delete {
            height: 19px;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-size: 7px;
        }

        .btn-edit {
            width: 37px;
            background: #f8f4ee;
            border: 1px solid #dfd2c2;
            color: #604c40;
        }

        .btn-edit:hover {
            background: #eee6da;
        }

        .btn-delete {
            width: 22px;
            background: #fff;
            border: 1px solid var(--me-danger);
            color: #c9857c;
            font-size: 9px;
        }

        .btn-delete:hover {
            background: #fff0ed;
        }

        /* =========================
           MODAL
        ========================= */

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(20, 14, 11, .52);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal {
            width: 430px;
            max-width: calc(100vw - 30px);
            background: #fbf8f2;
            border: 1px solid #dfd1c0;
            box-shadow: 0 15px 50px rgba(0,0,0,.20);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 20px 10px;
        }

        .modal-title {
            margin: 0;
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 400;
            color: #2a1c16;
        }

        .modal-close {
            border: 0;
            background: transparent;
            color: #8d7969;
            font-size: 18px;
            cursor: pointer;
        }

        .modal-body {
            padding: 4px 20px 20px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .form-label {
            display: block;
            margin-bottom: 5px;
            color: #7d6959;
            font-size: 7px;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }

            /* ESTILOS DEL MODAL DE REGISTRO */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            }

            .modal-container {
                background: #fff;
                width: 480px;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #eee;
                padding-bottom: 12px;
                margin-bottom: 16px;
            }

                .modal-header h3 {
                    font-family: 'Playfair Display', serif;
                    color: var(--sidebar-bg);
                }

            .close-modal {
                background: none;
                border: none;
                font-size: 1.2rem;
                cursor: pointer;
                color: var(--text-muted);
            }

            .form-group {
                margin-bottom: 12px;
            }

                .form-group label {
                    display: block;
                    font-size: 0.8rem;
                    font-weight: 600;
                    margin-bottom: 4px;
                    color: var(--text-dark);
                }

            .form-control {
                width: 100%;
                padding: 8px 12px;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 0.9rem;
            }

            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                margin-top: 20px;
            }

            .btn-cancel {
                background: #e0e0e0;
                border: none;
                padding: 8px 16px;
                border-radius: 6px;
                cursor: pointer;
            }
    </style>
</head>

<body>

<div class="seller-layout">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div>
            <div class="brand">
                <div class="brand-name">MAISON ÉLITE</div>
                <div class="brand-role">Vendedor</div>
            </div>

            <nav class="sidebar-menu">

                <a class="menu-link"
                   href="@Url.Action("Catalogo", "Home")">
                    <span class="menu-icon">□</span>
                    Catálogo
                </a>

                <a class="menu-link active"
                   href="@Url.Action("Clientes", "Home")">
                    <span class="menu-icon">○</span>
                    Clientes
                </a>

                <a class="menu-link"
                   href="@Url.Action("PuntoDeVenta", "Home")">
                    <span class="menu-icon">◐</span>
                    Punto de Venta
                </a>

            </nav>
        </div>

        <div class="sidebar-bottom">
            <a class="logout-link"
               href="@Url.Action("Index", "Home")">
                ↩
                Cerrar sesión
            </a>
        </div>

    </aside>


    <!-- =========================
         CONTENIDO
    ========================== -->

    <main class="main">

        <header class="topbar">
            <h1 class="page-title">Clientes</h1>

            <div class="user-circle">
                @inicial
            </div>
            <button id="btnAbrirModalCliente" class="btn-gold">
                <i class="fa-solid fa-user-plus"></i> Registrar Cliente
            </button>
        </header>


        <section class="content">

            <!-- =========================
                 RESUMEN
            ========================== -->

            <div class="summary-grid">

                <div class="summary-card">
                    <div class="summary-label">
                        Total clientes
                    </div>

                    <div class="summary-value"
                         id="totalClientes">
                        0
                    </div>
                </div>


                <div class="summary-card">
                    <div class="summary-label">
                        Clientes VIP
                    </div>

                    <div class="summary-value"
                         id="clientesVip">
                        0
                    </div>
                </div>


                <div class="summary-card">
                    <div class="summary-label">
                        Ingresos acumulados
                    </div>

                    <div class="summary-value"
                         id="ingresosAcumulados">
                        $0
                    </div>
                </div>

            </div>


            <!-- =========================
                 BUSCADOR
            ========================== -->

            <div class="toolbar">

                <input
                    type="text"
                    id="buscarCliente"
                    class="search-box"
                    placeholder="Buscar por nombre, DNI o email..."
                    autocomplete="off" />

                <select id="filtroCategoria"
                        class="filter-select">

                    <option value="Todos">Todos</option>
                    <option value="VIP">VIP</option>
                    <option value="Regular">Regular</option>
                    <option value="Nuevo">Nuevo</option>

                </select>

                <button type="button"
                        class="btn-primary"
                        onclick="abrirModalNuevo()">
                    + Registrar cliente
                </button>

            </div>


            <!-- =========================
                 TABLA
            ========================== -->

            <div class="table-container">

                <table class="clients-table">

                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>DNI</th>
                            <th>Ciudad</th>
                            <th class="number-center">Compras</th>
                            <th>Total</th>
                            <th>Categoría</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="tablaClientes">
                    </tbody>

                </table>

            </div>

        </section>

    </main>

    <!-- MODAL PARA REGISTRAR CLIENTE -->
    <div class="modal-overlay" id="modalCliente">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Registrar Nuevo Cliente</h3>
                <button class="close-modal" id="btnCerrarModal">&times;</button>
            </div>
            <form asp-controller="Home" asp-action="GuardarCliente" method="post">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" name="Nombre" class="form-control" placeholder="Ej: Sofía Martínez" required />
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="Correo" class="form-control" placeholder="Ej: correo@ejemplo.com" required />
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="Telefono" class="form-control" placeholder="Ej: +503 7000-0000" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" id="btnCancelarModal">Cancelar</button>
                    <button type="submit" class="btn-gold" style="border:none;">Guardar Cliente</button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT DE APERTURA Y CIERRE DEL MODAL -->
    <script>
            const modalCliente = document.getElementById('modalCliente');
            const btnAbrir = document.getElementById('btnAbrirModalCliente');
            const btnCerrar = document.getElementById('btnCerrarModal');
            const btnCancelar = document.getElementById('btnCancelarModal');

            btnAbrir.addEventListener('click', () => {
                modalCliente.style.display = 'flex';
            });

            btnCerrar.addEventListener('click', () => {
                modalCliente.style.display = 'none';
            });

            btnCancelar.addEventListener('click', () => {
                modalCliente.style.display = 'none';
            });
    </script>
</body>
</html>