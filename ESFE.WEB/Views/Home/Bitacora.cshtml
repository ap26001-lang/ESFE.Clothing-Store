@{
    ViewData["Title"] = "Bitácora - Maison Élite";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bitácora de Sistema - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .filter-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
                gap: 16px;
            }

            .search-wrapper {
                position: relative;
                flex: 1;
                max-width: 360px;
            }

                .search-wrapper i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                    font-size: 0.85rem;
                }

            .search-input {
                width: 100%;
                padding: 10px 14px 10px 38px;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                font-size: 0.85rem;
                outline: none;
                transition: border-color 0.2s;
            }

                .search-input:focus {
                    border-color: var(--gold-accent);
                }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

                .custom-table th {
                    padding: 14px 16px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }

            .badge-log {
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
                display: inline-block;
            }

            .badge-create {
                background-color: rgba(64, 130, 109, 0.12);
                color: #2e6050;
            }

            .badge-login {
                background-color: rgba(196, 164, 124, 0.2);
                color: #8a6d3b;
            }

            .badge-update {
                background-color: rgba(70, 130, 180, 0.12);
                color: #2b5b84;
            }

            .badge-delete {
                background-color: rgba(205, 92, 92, 0.12);
                color: #a33c3c;
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item"><a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="@Url.Action("Reportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item active"><a href="@Url.Action("Bitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item"><a href="@Url.Action("Respaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Bitácora de Eventos</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Auditoría y registro de acciones realizadas en el sistema.</p>
            </div>
        </header>

        <section class="content-card">
            <div class="filter-container">
                <div class="search-wrapper">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="txtBuscar" class="search-input" placeholder="Buscar por acción, usuario o detalle..." onkeyup="filtrarTabla()" />
                </div>
            </div>

            <table class="custom-table" id="tablaBitacora">
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Módulo</th>
                        <th>Módulo Afectado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>14 Sep 2026 - 10:45 AM</td>
                        <td>Admin</td>
                        <td><span class="badge-log badge-create">Creación</span></td>
                        <td>Inventario</td>
                        <td>Producto #PRD-003 agregado</td>
                    </tr>
                    <tr>
                        <td>14 Sep 2026 - 10:12 AM</td>
                        <td>Admin</td>
                        <td><span class="badge-log badge-login">Inicio de Sesión</span></td>
                        <td>Seguridad</td>
                        <td>Acceso exitoso al Admin Panel</td>
                    </tr>
                    <tr>
                        <td>14 Sep 2026 - 09:30 AM</td>
                        <td>Cajero_1</td>
                        <td><span class="badge-log badge-create">Creación</span></td>
                        <td>Ventas</td>
                        <td>Venta #VTA-1002 procesada</td>
                    </tr>
                    <tr>
                        <td>13 Sep 2026 - 04:15 PM</td>
                        <td>Admin</td>
                        <td><span class="badge-log badge-update">Modificación</span></td>
                        <td>Clientes</td>
                        <td>Datos del cliente #CLI-001 actualizados</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <script>
            function filtrarTabla() {
                const filtro = document.getElementById('txtBuscar').value.toLowerCase();
                const filas = document.querySelectorAll('#tablaBitacora tbody tr');

                filas.forEach(fila => {
                    const textoFila = fila.innerText.toLowerCase();
                    fila.style.display = textoFila.includes(filtro) ? '' : 'none';
                });
            }
    </script>
</body>
</html>