@{
    ViewData["Title"] = "Historial de Ventas - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Historial de Ventas - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            /* BARRA DE FILTROS Y BÚSQUEDA */
            .filter-bar {
                display: flex;
                gap: 16px;
                margin-bottom: 20px;
            }

            .search-input {
                flex: 1;
                padding: 10px 14px;
                border: 1px solid #e0e0e0;
                border-radius: 8px;
                font-size: 0.9rem;
                outline: none;
            }

                .search-input:focus {
                    border-color: var(--gold-accent);
                }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

                .custom-table th {
                    padding: 14px 16px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                    vertical-align: middle;
                }

            .badge-completed {
                background-color: rgba(64, 130, 109, 0.12);
                color: #40826d;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
            }

            /* BOTONES DE ACCIÓN */
            .btn-action {
                background: none;
                border: none;
                color: var(--sidebar-bg);
                cursor: pointer;
                font-size: 1.05rem;
                padding: 6px 8px;
                border-radius: 6px;
                transition: all 0.2s;
            }

                .btn-action:hover {
                    background-color: #f0ecf4;
                    color: var(--gold-accent);
                }

            /* MODAL DE TICKET */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            }

            .modal-container {
                background: #fff;
                width: 480px;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #eee;
                padding-bottom: 12px;
                margin-bottom: 16px;
            }

                .modal-header h3 {
                    font-family: 'Playfair Display', serif;
                    color: var(--sidebar-bg);
                }

            .close-modal {
                background: none;
                border: none;
                font-size: 1.2rem;
                cursor: pointer;
                color: var(--text-muted);
            }

            .ticket-info {
                font-size: 0.85rem;
                color: var(--text-muted);
                margin-bottom: 16px;
                line-height: 1.5;
            }

            .ticket-item {
                display: flex;
                justify-content: space-between;
                font-size: 0.9rem;
                padding: 8px 0;
                border-bottom: 1px dashed #eee;
            }

            .ticket-total {
                display: flex;
                justify-content: space-between;
                font-weight: 700;
                font-size: 1.1rem;
                margin-top: 16px;
                padding-top: 12px;
                border-top: 2px solid #2b2b2b;
            }

            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                margin-top: 20px;
            }

            .btn-print {
                background-color: var(--sidebar-bg);
                color: var(--gold-accent);
                border: 1px solid var(--gold-accent);
                padding: 8px 16px;
                border-radius: 6px;
                font-weight: 600;
                cursor: pointer;
            }

                .btn-print:hover {
                    background-color: var(--gold-accent);
                    color: #fff;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminCatalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminClientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminPuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item active"><a href="@Url.Action("AdminHistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminReportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminBitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item"><a href="@Url.Action("AdminRespaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Historial de Ventas</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Registro de transacciones realizadas en la tienda.</p>
            </div>
        </header>

        <section class="content-card">
            <!-- BUSCADOR INTERACTIVO -->
            <div class="filter-bar">
                <input type="text" id="txtBuscarVenta" class="search-input" placeholder="Buscar por N° Ticket o Cliente..." onkeyup="filtrarVentas()" />
            </div>

            <table class="custom-table">
                <thead>
                    <tr>
                        <th>N° Ticket</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th style="text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyHistorial">
                    <tr>
                        <td><strong>#VTA-1001</strong></td>
                        <td>14 Sep 2026 - 10:30 AM</td>
                        <td>Sofía Martínez</td>
                        <td>$557.09</td>
                        <td><span class="badge-completed">Completado</span></td>
                        <td style="text-align: center;">
                            <button class="btn-action" title="Ver Detalle" onclick="verDetalleTicket('#VTA-1001', 'Sofía Martínez', '14 Sep 2026 - 10:30 AM', 'Tarjeta', '$557.09')">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button class="btn-action" title="Imprimir Ticket" onclick="window.print()">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#VTA-1002</strong></td>
                        <td>14 Sep 2026 - 09:15 AM</td>
                        <td>Carlos Gómez</td>
                        <td>$250.00</td>
                        <td><span class="badge-completed">Completado</span></td>
                        <td style="text-align: center;">
                            <button class="btn-action" title="Ver Detalle" onclick="verDetalleTicket('#VTA-1002', 'Carlos Gómez', '14 Sep 2026 - 09:15 AM', 'Efectivo', '$250.00')">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button class="btn-action" title="Imprimir Ticket" onclick="window.print()">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#VTA-1003</strong></td>
                        <td>13 Sep 2026 - 04:40 PM</td>
                        <td>Valentina Ríos</td>
                        <td>$890.00</td>
                        <td><span class="badge-completed">Completado</span></td>
                        <td style="text-align: center;">
                            <button class="btn-action" title="Ver Detalle" onclick="verDetalleTicket('#VTA-1003', 'Valentina Ríos', '13 Sep 2026 - 04:40 PM', 'Transferencia', '$890.00')">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button class="btn-action" title="Imprimir Ticket" onclick="window.print()">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <!-- MODAL DETALLE DE TICKET -->
    <div class="modal-overlay" id="modalTicket">
        <div class="modal-container">
            <div class="modal-header">
                <h3 id="lblNumTicket">Detalle de Ticket</h3>
                <button class="close-modal" id="btnCerrarModal">&times;</button>
            </div>
            <div class="ticket-info">
                <div><strong>Cliente:</strong> <span id="lblClienteTicket">---</span></div>
                <div><strong>Fecha:</strong> <span id="lblFechaTicket">---</span></div>
                <div><strong>Pago:</strong> <span id="lblMetodoTicket">---</span></div>
            </div>

            <div style="border-top: 1px solid #eee; padding-top: 10px;">
                <div class="ticket-item">
                    <span>1x Blazer Cachemira</span>
                    <span>$250.00</span>
                </div>
                <div class="ticket-item">
                    <span>1x Vestido Seda Italiana</span>
                    <span>$243.00</span>
                </div>
            </div>

            <div class="ticket-total">
                <span>Total Cobrado:</span>
                <span id="lblTotalTicket">$0.00</span>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-print" onclick="window.print()"><i class="fa-solid fa-print"></i> Imprimir</button>
            </div>
        </div>
    </div>

    <!-- SCRIPT DE INTERACCIÓN -->
    <script>
            function filtrarVentas() {
                const input = document.getElementById('txtBuscarVenta').value.toLowerCase();
                const filas = document.querySelectorAll('#tbodyHistorial tr');

                filas.forEach(fila => {
                    const textoFila = fila.innerText.toLowerCase();
                    fila.style.display = textoFila.includes(input) ? '' : 'none';
                });
            }

            const modalTicket = document.getElementById('modalTicket');
            const btnCerrar = document.getElementById('btnCerrarModal');

            function verDetalleTicket(ticket, cliente, fecha, metodo, total) {
                document.getElementById('lblNumTicket').innerText = 'Detalle ' + ticket;
                document.getElementById('lblClienteTicket').innerText = cliente;
                document.getElementById('lblFechaTicket').innerText = fecha;
                document.getElementById('lblMetodoTicket').innerText = metodo;
                document.getElementById('lblTotalTicket').innerText = total;

                modalTicket.style.display = 'flex';
            }

            btnCerrar.addEventListener('click', () => {
                modalTicket.style.display = 'none';
            });
    </script>
</body>
</html>