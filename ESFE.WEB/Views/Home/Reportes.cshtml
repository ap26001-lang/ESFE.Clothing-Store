@{
    ViewData["Title"] = "Reportes - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reportes - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .reports-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 20px;
                margin-top: 16px;
            }

            .report-card {
                border: 1px solid #f0f0f0;
                border-radius: 10px;
                padding: 20px;
                text-align: center;
            }

            .report-icon {
                font-size: 2rem;
                color: var(--gold-accent);
                margin-bottom: 12px;
            }

            .btn-export {
                background-color: var(--sidebar-bg);
                color: var(--gold-accent);
                border: 1px solid var(--gold-accent);
                padding: 8px 16px;
                border-radius: 6px;
                cursor: pointer;
                margin-top: 12px;
                font-weight: 600;
                text-decoration: none;
                display: inline-block;
                font-size: 0.85rem;
            }

                .btn-export:hover {
                    background-color: var(--gold-accent);
                    color: #ffffff;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item"><a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item active"><a href="@Url.Action("Reportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item"><a href="@Url.Action("Bitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item"><a href="@Url.Action("Respaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Reportes y Estadísticas</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Generación de informes de ventas, inventario y rendimiento.</p>
            </div>
        </header>

        <section class="content-card">
            <div class="reports-grid">
                <div class="report-card">
                    <i class="fa-solid fa-file-invoice-dollar report-icon"></i>
                    <h3>Reporte de Ventas Mensual</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px;">Resumen detallado de los ingresos del mes.</p>
                    <a href="#" class="btn-export"><i class="fa-solid fa-download"></i> Descargar PDF</a>
                </div>
                <div class="report-card">
                    <i class="fa-solid fa-boxes-stacked report-icon"></i>
                    <h3>Inventario y Stock</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px;">Estado actual de existencias por categoría.</p>
                    <a href="#" class="btn-export"><i class="fa-solid fa-download"></i> Descargar Excel</a>
                </div>
                <div class="report-card">
                    <i class="fa-solid fa-user-check report-icon"></i>
                    <h3>Actividad de Clientes</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px;">Estadísticas de compras y fidelidad.</p>
                    <a href="#" class="btn-export"><i class="fa-solid fa-download"></i> Descargar PDF</a>
                </div>
            </div>
        </section>
    </main>

</body>
</html>