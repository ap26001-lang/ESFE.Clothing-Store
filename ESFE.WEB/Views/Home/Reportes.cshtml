@{
    ViewData["Title"] = "Respaldos - Maison Élite";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Respaldos de Base de Datos - Maison Élite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --sidebar-bg: #1c140e;
                --sidebar-hover: #2a1f17;
                --gold-accent: #c4a47c;
                --gold-light: #e5d3b3;
                --bg-main: #f8f6f2;
                --card-bg: #ffffff;
                --text-dark: #2b2b2b;
                --text-muted: #7f7f7f;
                --success-color: #2b7a5a;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                color: #d1d1d1;
            }

            .brand-header {
                padding: 0 12px 24px 12px;
                border-bottom: 1px solid rgba(196, 164, 124, 0.15);
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                color: var(--gold-accent);
                font-size: 1.4rem;
                letter-spacing: 2px;
                font-weight: 600;
            }

            .brand-subtitle {
                font-size: 0.75rem;
                color: var(--gold-light);
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0.8;
            }

            .nav-menu {
                list-style: none;
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item.active a, .nav-item a:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .nav-item.active a {
                border-left: 3px solid var(--gold-accent);
                color: var(--gold-accent);
            }

            .nav-item i {
                font-size: 1rem;
                width: 20px;
            }

            .sidebar-footer {
                border-top: 1px solid rgba(196, 164, 124, 0.15);
                padding-top: 16px;
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #b0a8a0;
                text-decoration: none;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 32px 40px;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }

            .header-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .page-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.8rem;
                color: var(--text-dark);
            }

            .btn-create-backup {
                background-color: var(--sidebar-bg);
                color: var(--gold-light);
                border: 1px solid var(--gold-accent);
                padding: 10px 18px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
            }

                .btn-create-backup:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

            .content-card {
                background-color: var(--card-bg);
                padding: 28px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

                .custom-table th {
                    padding: 14px 16px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--text-muted);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border-bottom: 2px solid #f0f0f0;
                }

                .custom-table td {
                    padding: 16px;
                    font-size: 0.9rem;
                    border-bottom: 1px solid #f0f0f0;
                }

            .file-name {
                font-weight: 700;
                color: var(--text-dark);
            }

            .status-completed {
                color: var(--success-color);
                font-weight: 600;
            }

            .actions-cell {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .btn-action {
                background: none;
                border: none;
                color: var(--gold-accent);
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: color 0.2s;
            }

                .btn-action:hover {
                    color: var(--sidebar-bg);
                    text-decoration: underline;
                }

            .btn-restore {
                color: var(--text-muted);
            }

                .btn-restore:hover {
                    color: #a33c3c;
                }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand-header">
                <div class="brand-title">MAISON ÉLITE</div>
                <div class="brand-subtitle">Administrador</div>
            </div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="@Url.Action("AdminDashboard", "Home")"><i class="fa-solid fa-compass"></i> Dashboard</a></li>
                <li class="nav-item"><a href="@Url.Action("Catalogo", "Home")"><i class="fa-solid fa-book-open"></i> Catálogo</a></li>
                <li class="nav-item"><a href="@Url.Action("Clientes", "Home")"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="nav-item"><a href="@Url.Action("PuntoDeVenta", "Home")"><i class="fa-solid fa-cash-register"></i> Punto de Venta</a></li>
                <li class="nav-item"><a href="@Url.Action("HistorialVentas", "Home")"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Ventas</a></li>
                <li class="nav-item"><a href="@Url.Action("Reportes", "Home")"><i class="fa-solid fa-chart-pie"></i> Reportes</a></li>
                <li class="nav-item"><a href="@Url.Action("Bitacora", "Home")"><i class="fa-solid fa-list-check"></i> Bitácora</a></li>
                <li class="nav-item active"><a href="@Url.Action("Respaldos", "Home")"><i class="fa-solid fa-shield-halved"></i> Respaldos</a></li>
            </ul>
        </div>
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Home")" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="header-bar">
            <div>
                <h1 class="page-title">Respaldos de Base de Datos</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Genera y restaura copias de seguridad del sistema.</p>
            </div>
            <button class="btn-create-backup" id="btnCrearRespaldo" onclick="crearRespaldo()">
                <i class="fa-solid fa-database"></i> Crear Nuevo Respaldo
            </button>
        </header>

        <section class="content-card">
            <table class="custom-table" id="tablaRespaldos">
                <thead>
                    <tr>
                        <th>Archivo</th>
                        <th>Fecha de Creación</th>
                        <th>Tamaño</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="file-name">backup_maison_20260914.bak</td>
                        <td>14 Sep 2026 - 08:00 AM</td>
                        <td>14.2 MB</td>
                        <td><span class="status-completed">Completado</span></td>
                        <td>
                            <div class="actions-cell">
                                <button class="btn-action" onclick="descargarRespaldo('backup_maison_20260914.bak')">
                                    <i class="fa-solid fa-download"></i> Descargar
                                </button>
                                <button class="btn-action btn-restore" onclick="restaurarRespaldo('backup_maison_20260914.bak')">
                                    <i class="fa-solid fa-rotate-left"></i> Restaurar
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <script>
            function crearRespaldo() {
                const btn = document.getElementById('btnCrearRespaldo');
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generando...';

                setTimeout(() => {
                    const ahora = new Date();
                    const anio = ahora.getFullYear();
                    const mes = String(ahora.getMonth() + 1).padStart(2, '0');
                    const dia = String(ahora.getDate()).padStart(2, '0');
                    const fechaTexto = `${dia} Sep ${anio} - ${ahora.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

                    const nombreArchivo = `backup_maison_${anio}${mes}${dia}_${ahora.getHours()}${ahora.getMinutes()}.bak`;
                    const tamano = (Math.random() * (15.5 - 14.0) + 14.0).toFixed(1) + ' MB';

                    const tbody = document.querySelector('#tablaRespaldos tbody');
                    const nuevaFila = document.createElement('tr');

                    nuevaFila.innerHTML = `
                                <td class="file-name">${nombreArchivo}</td>
                                <td>${fechaTexto}</td>
                                <td>${tamano}</td>
                                <td><span class="status-completed">Completado</span></td>
                                <td>
                                    <div class="actions-cell">
                                        <button class="btn-action" onclick="descargarRespaldo('${nombreArchivo}')">
                                            <i class="fa-solid fa-download"></i> Descargar
                                        </button>
                                        <button class="btn-action btn-restore" onclick="restaurarRespaldo('${nombreArchivo}')">
                                            <i class="fa-solid fa-rotate-left"></i> Restaurar
                                        </button>
                                    </div>
                                </td>
                            `;

                    tbody.insertBefore(nuevaFila, tbody.firstChild);

                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-database"></i> Crear Nuevo Respaldo';
                }, 1500);
            }

            function descargarRespaldo(nombre) {
                const contenido = "-- Backup Maison Elite Database --\n-- Generado automáticamente --";
                const blob = new Blob([contenido], { type: 'application/octet-stream' });
                const enlace = document.createElement('a');
                enlace.href = URL.createObjectURL(blob);
                enlace.download = nombre;
                enlace.click();
            }

            function restaurarRespaldo(nombre) {
                if (confirm(`¿Está seguro de que desea restaurar la base de datos con el archivo ${nombre}?\n\nEsta acción reiniciará los parámetros del sistema.`)) {
                    alert(`Restauración iniciada exitosamente desde ${nombre}.`);
                }
            }
    </script>
</body>
</html>